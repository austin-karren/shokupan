{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "commit_title_max_length": 72,
    "dock": "left",
  },
  "lsp": {
    /*
      🗒️ note: this config allows tailwind language server to run in CVA and CX objects
    */
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classFunctions": ["cva", "cx"],
        },
      },
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave",
        },
      },
    },
    /*
      Biome
      🗒️ note: biome is dead to me due to how zed handles language servers and oxlint works great
    */
    "typos": {
      "initialization_options": {
        "config": ".typos.toml",
        "path": "typos-lsp",
        "diagnosticSeverity": "Warning",
        "logLevel": "info",
        "trace.server": "off",
      },
    },
  },

  /*
    ⚠️ warning: leave disabled until zed fixes this
    🗒️ note: once zed supports fallbacks switch to tsgo
  */
  // "languages": {
  //   "TypeScript": {
  //     "language_servers": ["tsgo", "vtsls", "!typescript-language-server", "..."],
  //   },
  //   "TSX": {
  //     "language_servers": ["tsgo", "vtsls", "!typescript-language-server", "..."],
  //   },
  // },

  /* Behaviors */
  "format_on_save": "on",

  /*
    🗒️ note: shiptrac-platform is ~1.1M files (1.06M of them under node_modules).
    Zed's foreground worktree-snapshot applier (worktree.rs:1363 in 1.14.2) blocked
    the main thread 20-25s applying scans of that tree — the source of the lag and
    Hyprland's "not responding" dialogs (hang traces: ~/.local/share/zed/hang_traces).
    Excluding the dirs drops the scanned tree to ~54k files; hangs go away.
    ⚠️ warning: this key REPLACES Zed's defaults rather than merging, so the stock
    entries (.git through .settings) have to be restated here.
    ⚠️ warning: excluded dirs vanish from the project panel, file finder, and search;
    go-to-definition into node_modules still opens the file.
  */
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.turbo",
    "**/.next",
    "**/.sst"
  ],

  /*
    Extensions 🧩
    ⚠️ warning: this key REPLACES the default of { "html": true } rather than merging,
    so everything wanted has to be listed. Setting one to false uninstalls it.
    🗒️ note: ids are registry ids (api.zed.dev/extensions), not display names.
  */
  "auto_install_extensions": {
    /* Themes */
    "catppuccin": true, // 🐱 Latte / Frappé / Macchiato / Mocha, each ± italics
    /* Tooling */
    "git-firefly": true, // Git Firefly
    "oxc": true, // oxlint + oxfmt, configured under "lsp" above
    "tsgo": true, // "TypeScript Language Server" — see the disabled block above
    "typos": true, // typos-lsp, configured under "lsp" above
    /* Languages */
    "astro": true,
    "dockerfile": true,
    "elixir": true,
    "html": true,
    "java": true,
    "log": true,
    "scss": true, // SCSS & SASS
    "sql": true,
    "svelte": true,
    "terraform": true,
    "toml": true,
    "vue": true,
  },

  /*
    Themes 🎨
    🗒️ note: these come from the catppuccin extension, not Zed's built-ins. Drop the
    " - No Italics" suffix for the italic variants the macOS repo uses.
    ⚠️ warning: naming a theme whose extension is missing does not fail loudly — Zed
    falls back to One Dark/One Light and writes that fallback back into this file,
    which reads as the config silently reverting itself.
  */
  "theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha - No Italics", // ⚫
    "light": "Catppuccin Latte - No Italics", // 🟤
    // dark: "Andromeda" // ✨
  },

  /*
    🗒️ note: see keymap.json
  */
  "base_keymap": "VSCode",

  /* Editor  */
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "ui_font_family": "JetBrainsMono Nerd Font", // 🐧 linux: MonoLisa is not installed on this machine
  "extend_comment_on_newline": false,
  "soft_wrap": "editor_width",
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "file_types": {
    "JSONC": ["tsconfig*.json", "base.json", "internal-package.json"],
  },

  /* Hidden Items */
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },

  /* Agents 🤖 */
  "agent": {
    "sidebar_side": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "right",
    "default_profile": "write",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "open": true,
          "contents": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "thinking": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-5",
    },
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
    },
    "commit_message_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "thread_summary_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "button": true,
  },
}
