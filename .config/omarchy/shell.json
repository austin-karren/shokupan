{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omenu",
          "type": "qml"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "barcfg",
          "type": "qml"
        }
      ],
      "center": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "calendar",
          "type": "qml"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "ratio-on",
          "type": "qml"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "Dnd"
          ]
        },
        {
          "id": "ratio",
          "type": "qml"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "Reminder",
            "NightLight",
            "StayAwake",
            "ScreenRecording",
            "Dictation"
          ]
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.notifications"
        },
        {
          "id": "apexshot",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 3
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.spacer",
          "size": 2
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "network",
          "type": "qml"
        },
        {
          "id": "omarchy.audio",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/audio.qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 4
        },
        {
          "id": "microphone",
          "type": "qml"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "shokupan.launcher"
    }
  ]
}
