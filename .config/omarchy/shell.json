{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omenu",
          "type": "qml"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "barcfg",
          "type": "qml"
        },
        {
          "id": "calendar",
          "type": "qml"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "indicators",
          "type": "qml",
          "items": [
            "Dnd",
            "Ratio",
            "Reminder",
            "NightLight",
            "StayAwake",
            "ScreenRecording",
            "Dictation"
          ]
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.notifications"
        },
        {
          "id": "apexshot",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 3
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.spacer",
          "size": 2
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "network",
          "type": "qml"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.spacer",
          "size": 4
        },
        {
          "id": "microphone",
          "type": "qml"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "shokupan.launcher"
    },
    {
      "id": "shokupan.dpms-guard"
    }
  ]
}
