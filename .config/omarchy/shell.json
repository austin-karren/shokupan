{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "shokupan.omenu",
          "trailingGap": 8
        },
        {
          "id": "jankeesvw.workspace-name",
          "indicators": true,
          "numbers": true,
          "alwaysShown": 10
        }
      ],
      "center": [
        {
          "id": "indicators",
          "type": "qml",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake",
            "Ratio"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "io.github.dicemans.docker-vms",
          "showStats": false
        },
        {
          "id": "shokupan.apexshot"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "austinkarren.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "shokupan.dpms-guard"
    }
  ]
}
