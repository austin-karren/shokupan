{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "austinkarren.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "indicators",
          "type": "qml",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake",
            "Ratio"
          ]
        },
        {
          "id": "austinkarren.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "shokupan.apexshot"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "shokupan.dpms-guard"
    }
  ]
}
