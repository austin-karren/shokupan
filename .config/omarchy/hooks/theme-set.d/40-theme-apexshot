#!/bin/bash

# Repaint what ApexShot lets us repaint, from the active theme.
#
# ApexShot is a third-party screenshot tool (ADR-0044's reversal addendum). It
# knows nothing about Omarchy themes and exposes exactly two colour knobs, both
# in YAML it owns:
#
#   config.yml        wallpaper_plain_color   the backdrop behind a capture
#   editor_prefs.yml  color: {r,g,b,a}        the annotation pen
#
# Both are driven here. The pen was deliberately left alone when this hook was
# written on 2026-08-16 — the reasoning being that it is a live user choice —
# but the user asked for it themed (2026-08-17: "apex shot still is orange
# themed would love it to match my omarchy theme"), so it now follows the
# theme's `red`, the same colour the bar uses for modules calling attention to
# themselves. Alpha is preserved: it is a real preference, not a colour.
#
# WHAT THIS CANNOT REACH, so nobody re-opens it hopefully: ApexShot's own UI
# chrome. Its accent is a hardcoded terracotta family compiled into the binary
# (#b05c38 with #c06540 / #9a4c2c / #e8764a / #f0a07a alongside — 87 hits on
# the first alone), with no config key and no external stylesheet. Only a global
# GTK4 user stylesheet could touch it, which would repaint every GTK4 app on the
# machine to fix one; that trade is the user's to make, not this hook's. See
# docs/upstream/apexshot-theme-support.md.
#
# Both files are rewritten by ApexShot itself when its UI changes a setting, so
# every edit below is keyed and in-place: whatever else the user set survives a
# theme change. A running ApexShot may also overwrite the pen on exit; the next
# theme-set puts it back.

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/apexshot"
COLORS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"

[[ -f $COLORS ]] || exit 0

hex_of() {
  sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$COLORS" | head -1
}

# --- the capture backdrop ---------------------------------------------------
background=$(hex_of background)
if [[ -n $background && -f $CONFIG_DIR/config.yml ]] &&
  grep -q '^wallpaper_plain_color:' "$CONFIG_DIR/config.yml"; then
  sed -i "s|^wallpaper_plain_color:.*|wallpaper_plain_color: '$background'|" \
    "$CONFIG_DIR/config.yml"
fi

# --- the annotation pen -----------------------------------------------------
# Only the r/g/b lines of the single `color:` block, addressed by their position
# inside it rather than by pattern: `r:`/`g:`/`b:` are too generic to sed
# globally in a file that may grow other nested blocks.
pen=$(hex_of red)
if [[ -n $pen && -f $CONFIG_DIR/editor_prefs.yml ]]; then
  PEN_HEX="$pen" python3 - "$CONFIG_DIR/editor_prefs.yml" <<'PY'
import os, re, sys

path = sys.argv[1]
hexval = os.environ["PEN_HEX"].lstrip("#")
r, g, b = (int(hexval[i:i + 2], 16) for i in (0, 2, 4))

channel = {"r": r, "g": g, "b": b}
out, inside, written = [], False, set()
for line in open(path).read().splitlines(keepends=True):
    if re.match(r"^color:\s*$", line):
        inside = True
        out.append(line)
        continue
    if inside:
        m = re.match(r"^(\s+)([rgb]):\s*\d+\s*$", line)
        if m and m.group(2) not in written:
            written.add(m.group(2))
            out.append(f"{m.group(1)}{m.group(2)}: {channel[m.group(2)]}\n")
            continue
        # The block ends at the first line that is not one of its own keys.
        if not re.match(r"^\s+[a-z]+:", line):
            inside = False
    out.append(line)

open(path, "w").write("".join(out))
PY
fi
