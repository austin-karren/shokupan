#!/bin/bash

# loaf:summary=Re-assert the rice on top of whatever the base layers did
# loaf:args=[--dry-run]

# The reconciliation half of `loaf doctor`. Runs after an Omarchy or CachyOS
# update — automatically via ~/.config/omarchy/hooks/post-update.d — to put the
# rice back on top of a base that moved underneath it.
#
# The failure it exists for: Omarchy's migrations rewrite files in ~/.config. On
# a stowed machine the thing being rewritten is one of our symlinks, so Omarchy
# replaces the link with a fresh default and our config silently stops being
# live. The `.bak.<epoch>` files it leaves behind are the fingerprint.
#
# Nothing here is destructive. A file that displaced one of our symlinks is moved
# aside as .displaced.<epoch>, never deleted — it is the new upstream default and
# usually worth reading before discarding.

set -uo pipefail

# $LOAF_HOME is $HOME everywhere except the test suite, which points it at a
# fixture tree. Every path below derives from it, so nothing reaches the real
# home directory unless it was asked to.
LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"
STATE_DIR="${XDG_STATE_HOME:-$LOAF_HOME/.local/state}/loaf"
# Migrations run as child processes and touch paths in the home directory, so
# they need the same injectable root — otherwise a test migration would edit the
# real $HOME.
export LOAF_HOME LOAF_ROOT
# Sibling loaf-* commands resolve relative to this script, not to a PATH that
# may not contain ~/.local/bin yet — on a fresh machine the symlinks only land
# after the first stow pass. Measured in the lab: heal silently skipped debloat.
PATH="$(dirname "$(realpath "$0")"):$PATH"
# Sibling loaf-* commands resolve relative to this script, not to a PATH that
# may not contain ~/.local/bin yet — on a fresh machine the symlinks only land
# after the first stow pass. Measured in the lab: heal silently skipped debloat.
PATH="$(dirname "$(realpath "$0")"):$PATH"
APPLIED="$STATE_DIR/applied"

# Must match loaf-doctor's list and .stow-local-ignore — see the note there.
REPO_ONLY='^(lab/|docs/|packages/|migrations/|test/|README|LICENSE|COPYING|CONTEXT|CLAUDE|packages\.txt|\.gitignore|\.stow-local-ignore)'
dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

stamp=$(date +%s)
changed=0
# The shell registers bar/modules/ files only at startup, so a heal that placed
# one has silently not finished until the shell restarts (ADR-0042 want 3).
bar_touched=false

say() { printf '  %s\n' "$1"; }
act() {
  changed=$((changed + 1))
  printf '  \033[32m→\033[0m %s\n' "$1"
}

# Not before the dry-run check: creating the state directory is itself a write,
# and --dry-run promises not to touch the disk.
$dry_run || mkdir -p "$STATE_DIR"

printf '\033[1mHealing %s\033[0m%s\n' "$LOAF_ROOT" "$($dry_run && echo ' (dry run)')"

# ---------------------------------------------------------
# 1. Restore symlinks the base layers displaced
# ---------------------------------------------------------

while IFS= read -r f; do
  target="$LOAF_HOME/$f"
  # A real file where a symlink belongs means something overwrote us.
  if [[ -e $target && ! -L $target ]]; then
    if $dry_run; then
      act "would restore $f (displacing the real file)"
      continue
    fi
    mv "$target" "$target.displaced.$stamp"
    mkdir -p "$(dirname "$target")"
    ln -s "$(realpath --relative-to="$(dirname "$target")" "$LOAF_ROOT/$f")" "$target"
    act "restored $f — upstream's version kept as $(basename "$target").displaced.$stamp"
    [[ $f == *.config/omarchy/bar/modules/* ]] && bar_touched=true
  fi
  # Same exclusions as loaf-doctor: repo-only paths and Stow metadata never
  # belong in $LOAF_HOME, so a real file at those paths is not a displaced symlink.
done < <(git -C "$LOAF_ROOT" ls-files |
  grep -vE "$REPO_ONLY")

# ---------------------------------------------------------
# 2. Stow anything not yet installed
# ---------------------------------------------------------

if command -v stow &>/dev/null; then
  # --no-folding keeps directories real, so Omarchy dropping a new file into
  # ~/.config/hypr does not land inside the repo by way of a folded directory.
  if $dry_run; then
    stow_out=$(cd "$LOAF_ROOT" && stow -v --simulate --no-folding . 2>&1)
    stow_rc=$?
  else
    stow_out=$(cd "$LOAF_ROOT" && stow -v --no-folding . 2>&1)
    stow_rc=$?
  fi
  # A failed stow used to be reported as a green "change" — the aborted-restow
  # trap ADR-0042 want 4 names. Failure is failure, and it stops the run: the
  # sections below assume the links are live.
  if ((stow_rc)); then
    printf '  \033[31m✗\033[0m stow failed:\n'
    printf '    %s\n' "$stow_out"
    exit 1
  fi
  if [[ -n $stow_out ]]; then
    act "stow:"
    printf '    %s\n' "$stow_out"
    [[ $stow_out == *bar/modules* ]] && bar_touched=true
  else
    say "stow: nothing to do"
  fi
else
  say "stow: not installed — skipped"
fi

# ---------------------------------------------------------
# 2a. Re-assert the plugins checkout
# ---------------------------------------------------------

# The plugins live in their own repo since the 2026-08-18 split, so stow no
# longer installs them; loaf-plugins owns that. --offline keeps heal off the
# network: an existing checkout is re-linked, a missing one fails loudly rather
# than cloning behind the user's back.
if command -v loaf-plugins &>/dev/null; then
  if $dry_run; then
    plugins_out=$(loaf-plugins --offline --dry-run 2>&1)
  else
    plugins_out=$(loaf-plugins --offline 2>&1)
  fi
  if [[ -n $plugins_out ]]; then
    while IFS= read -r line; do act "$line"; done <<<"$plugins_out"
    # Bar modules register at shell startup only, and they arrive here now
    # rather than through stow.
    [[ $plugins_out == *bar/modules* ]] && bar_touched=true
  else
    say "plugins: nothing to do"
  fi
fi

# ---------------------------------------------------------
# 2b. Copy theme files (the one COPY-class tree)
# ---------------------------------------------------------

# .config/omarchy/themes is stow-ignored on purpose: omarchy-theme-set stages
# a user theme with cp -r, which copies a stow symlink AS a relative symlink —
# dangling at the staging path, so a section override like tokyo-night's
# shell.bar.toml silently never applies (measured 2026-08-15). Real files are
# what upstream's own theme-install produces, so heal installs these by copy.
THEMES_SRC="$LOAF_ROOT/.config/omarchy/themes"
THEMES_DST="$LOAF_HOME/.config/omarchy/themes"
if [[ -d $THEMES_SRC ]]; then
  themes_changed=false
  while IFS= read -r -d '' src; do
    rel=${src#"$THEMES_SRC"/}
    dst="$THEMES_DST/$rel"
    # A leftover symlink from the stow era must give way to a real file.
    if [[ -L $dst ]] || ! cmp -s "$src" "$dst" 2>/dev/null; then
      if $dry_run; then
        act "themes: would copy $rel"
      else
        mkdir -p "$(dirname "$dst")"
        rm -f "$dst"
        cp "$src" "$dst"
        act "themes: copied $rel"
      fi
      themes_changed=true
    fi
  done < <(find "$THEMES_SRC" -type f -print0)
  $themes_changed || say "themes: in sync"
fi

# ---------------------------------------------------------
# 3. Re-remove Omarchy defaults decided against
# ---------------------------------------------------------

# omarchy-refresh-applications restores every default web app on refresh, so
# a post-update heal has to take them back off. loaf-debloat owns the how; the
# manifest at packages/removed.webapps owns the what.
if command -v loaf-debloat &>/dev/null; then
  if $dry_run; then
    debloat_out=$(loaf-debloat --dry-run)
  else
    debloat_out=$(loaf-debloat)
  fi
  if [[ -n $debloat_out ]]; then
    while IFS= read -r line; do act "debloat: $line"; done <<<"$debloat_out"
  else
    say "debloat: nothing to remove"
  fi
fi

# ---------------------------------------------------------
# 4. Re-assert the wallpaper pool
# ---------------------------------------------------------

# An upstream update can add, rename or delete theme wallpapers, which grows
# stale or dangling symlinks in the Tokyo Night pool. loaf-wallpapers owns the
# how; the manifest at packages/wallpapers owns the deleted-history half.
# --offline keeps heal off the network: present files re-link, missing ones
# wait for a manual `loaf wallpapers`.
if command -v loaf-wallpapers &>/dev/null; then
  if $dry_run; then
    wallpapers_out=$(loaf-wallpapers --offline --dry-run)
  else
    wallpapers_out=$(loaf-wallpapers --offline)
  fi
  if [[ -n $wallpapers_out ]]; then
    while IFS= read -r line; do act "wallpapers: $line"; done <<<"$wallpapers_out"
  else
    say "wallpapers: nothing to do"
  fi
fi

# ---------------------------------------------------------
# 5. Apply pending migrations
# ---------------------------------------------------------

# Migrations exist because this machine cannot be rebuilt to get a fix — it is
# the machine. Each is a one-shot, idempotent script named for the epoch second
# it was written, applied once and recorded in the ledger.
$dry_run || touch "$APPLIED"
pending=()
if [[ -d $LOAF_ROOT/migrations ]]; then
  for m in "$LOAF_ROOT"/migrations/*.sh; do
    [[ -e $m ]] || continue
    # The ledger may not exist yet on a dry run, which is not an error.
    grep -qxF "$(basename "$m")" "$APPLIED" 2>/dev/null || pending+=("$m")
  done
fi

if ((${#pending[@]} == 0)); then
  say "migrations: none pending"
else
  for m in "${pending[@]}"; do
    name=$(basename "$m")
    if $dry_run; then
      act "would apply $name"
      continue
    fi
    if bash "$m"; then
      echo "$name" >>"$APPLIED"
      act "applied $name"
    else
      printf '  \033[31m✗\033[0m migration %s failed — not recorded, will retry\n' "$name"
      exit 1
    fi
  done
fi

# ---------------------------------------------------------

if $bar_touched && ! $dry_run; then
  # Restart rather than merely advise when the shell is actually reachable:
  # upstream's own updater does the same, and a heal that placed a bar module
  # without a restart has silently not finished.
  if command -v omarchy-restart-shell &>/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    omarchy-restart-shell &>/dev/null
    act "bar/modules changed — restarted the shell"
  else
    act "bar/modules changed — restart the shell to register them (omarchy-restart-shell)"
  fi
fi

$dry_run || touch "$STATE_DIR/last-heal"

echo
if ((changed)); then
  printf '\033[32m%d change(s).\033[0m Run \033[1mloaf doctor\033[0m to confirm.\n' "$changed"
else
  printf 'Nothing to heal.\n'
fi
