#!/bin/bash

# loaf:summary=Check recorded forks and watched upstream files for drift
# loaf:args=[--record] [--quiet]

# The rice depends on upstream files in two ways it cannot patch in place
# (ADR-0027, ADR-0042). FORKS are copies — the launcher plugin, the indicators
# cluster, the shell.toml.tpl template — where upstream fixes never arrive on
# their own. WATCHES are upstream files loaded whole from /usr/share by hosted
# widgets that depend on their internal structure; a refactor there makes a
# rebind silently stop applying. Either way nothing else notices upstream
# moving — quickshell's output goes to /dev/null, so the first sign of drift
# is visual.
#
# packages/forks records, per dependency, the upstream file and the SHA-256 it
# had when last verified (a trailing `watch` field marks the second kind). This
# command compares; an omarchy update that touches a recorded file turns the
# board red instead of leaving stale drift. A changed watch is not breakage —
# the coupling usually survives — so its message says re-verify, not re-diff.
# `--record` re-stamps the hashes after a re-verification — the same by-hand
# contract as packages/omarchy.pin.

set -uo pipefail

LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"
MANIFEST="$LOAF_ROOT/packages/forks"

quiet=false
record=false
for arg in "$@"; do
  case $arg in
  --quiet) quiet=true ;;
  --record) record=true ;;
  *)
    echo "usage: loaf forks [--record] [--quiet]" >&2
    exit 64
    ;;
  esac
done

if [[ ! -f $MANIFEST ]]; then
  # No manifest means no claim.
  $quiet || echo "loaf: no fork manifest at $MANIFEST"
  exit 0
fi

problems=0
out=""

while read -r rice_path upstream_path recorded_sha mode; do
  [[ -n ${recorded_sha:-} ]] || continue
  if [[ ! -e $LOAF_ROOT/$rice_path ]]; then
    problems=$((problems + 1))
    out+="✗ $rice_path — rice file missing from the repo"$'\n'
    continue
  fi
  if [[ ! -e $upstream_path ]]; then
    problems=$((problems + 1))
    out+="✗ $rice_path — upstream $upstream_path no longer exists (renamed?)"$'\n'
    continue
  fi
  current_sha=$(sha256sum "$upstream_path" | awk '{print $1}')
  if [[ $current_sha == "$recorded_sha" ]]; then
    out+="✓ $rice_path — upstream unchanged since verification"$'\n'
  elif [[ ${mode:-} == watch ]]; then
    problems=$((problems + 1))
    out+="✗ $rice_path — watched upstream file changed"$'\n'
    out+="    $upstream_path changed since the coupling was verified"$'\n'
    out+="    re-verify the module still applies, then: loaf forks --record"$'\n'
  else
    problems=$((problems + 1))
    out+="✗ $rice_path — upstream moved under the fork"$'\n'
    out+="    $upstream_path changed since the fork was verified"$'\n'
    out+="    re-diff, carry the fix across, then: loaf forks --record"$'\n'
  fi
done < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$MANIFEST")

if $record; then
  # Rewrite the manifest line by line, re-stamping only the hash field, so
  # comments and blank lines stay exactly where they were written.
  tmp=$(mktemp)
  while IFS= read -r line; do
    stripped=${line%%#*}
    if [[ -z ${stripped// /} ]]; then
      printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    read -r rice_path upstream_path _ mode <<<"$stripped"
    [[ -n ${upstream_path:-} && -e $upstream_path ]] || continue
    printf '%s %s %s%s\n' "$rice_path" "$upstream_path" \
      "$(sha256sum "$upstream_path" | awk '{print $1}')" \
      "${mode:+ $mode}" >>"$tmp"
  done <"$MANIFEST"
  mv "$tmp" "$MANIFEST"
  $quiet || echo "recorded — commit packages/forks with the re-verification"
  exit 0
fi

$quiet || printf '%s' "$out"
((problems)) && exit 1
exit 0
