#!/bin/bash

# weather-icon - the bar's weather glyph, served from a cache so it never blanks.
#
# omarchy:summary=Weather glyph and status for the bar, cached so a failed fetch costs accuracy rather than the icon.
#
# Omarchy's stock module (`$OMARCHY_PATH/default/waybar/weather.sh`) prints an
# empty string whenever its fetch fails, and Waybar hides a custom module whose
# text is empty. So a failed request does not leave the icon stale - it removes
# it, until some later request happens to succeed. Two measured things make that
# likely rather than rare:
#
#   - At login Waybar starts before the network is up. On this machine waybar
#     started 12:50:31 and NetworkManager reported `startup complete` at
#     12:50:33.8, so the first poll cannot resolve wttr.in at all.
#   - `--max-time 3` is tight for wttr.in's j1 endpoint. Warm it answers in
#     ~0.9s, but upstream re-fetches on a cache miss and then regularly exceeds
#     three seconds - so the retry a minute later can fail for a second,
#     unrelated reason.
#
# Every poll is independent, so the bar has no memory and each hiccup shows as a
# hole. This gives it a memory: fetch on a long interval, keep the last good
# reading on disk, render from that. The failure then costs accuracy instead of
# the icon.
#
# It also collapses three requests into one. Upstream fetches once for the glyph
# and, on click, twice more for the notification - so a click is three requests
# to a service that rate-limits. Everything here comes from one j1 document,
# fetched every 15 minutes rather than every 60 seconds: 4 requests an hour
# where the stock module makes 60.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
CACHE="$STATE_DIR/weather.json"
LOCKFILE="$STATE_DIR/weather.lock"

TTL=900           # refresh a reading older than this
STALE_AFTER=10800 # ...and let the bar admit it is old past this
TIMEOUT=10        # generous on purpose - see the --max-time 3 note above
SIGNAL=12         # RTMIN+12, matching "signal" on custom/weather in config.jsonc

# Retry schedule for one background refresh, in seconds. This is the boot case:
# rather than fail once and leave the next attempt to Waybar's 60s poll, a
# single refresher keeps trying, so the first reading lands within a few seconds
# of the network arriving instead of up to a minute later.
BACKOFF=(2 5 10 20 40)

# --- fetching ---------------------------------------------------------------

# One j1 document supplies everything: the condition code for the glyph, the
# sunrise/sunset pair the glyph needs to choose between sun and moon, and the
# place/temperature/wind the notification shows. Written atomically so a poll
# that reads the cache mid-write cannot see half a document.
fetch_once() {
  local json now
  mkdir -p "$STATE_DIR" || return 1
  json=$(curl -fsS --max-time "$TIMEOUT" "https://wttr.in?format=j1" 2>/dev/null) || return 1
  now=$(date +%s)

  jq -e --argjson now "$now" '
    .current_condition[0] as $c
    | .weather[0].astronomy[0] as $a
    | {
        code:    $c.weatherCode,
        temp:    $c.temp_F,
        wind:    $c.windspeedMiles,
        winddir: $c.winddirDegree,
        place:   .nearest_area[0].areaName[0].value,
        sunrise: $a.sunrise,
        sunset:  $a.sunset,
        fetched: $now,
      }
    | select(all(.[]; . != null and . != ""))
  ' <<<"$json" >"$CACHE.new" 2>/dev/null || {
    rm -f "$CACHE.new"
    return 1
  }

  [[ -s $CACHE.new ]] || { rm -f "$CACHE.new"; return 1; }
  mv -f "$CACHE.new" "$CACHE"
}

# Refresh in the background, then poke Waybar so the new reading appears at once
# instead of at the next poll.
refresh() {
  # One refresher at a time. Waybar polls every 60s and every poll during an
  # outage would otherwise want its own retry ladder, stacking overlapping curls
  # against a service that rate-limits.
  #
  # Nothing outside this function creates $STATE_DIR: rendering and --check-icons
  # must leave the disk untouched, because `loaf doctor` calls the latter and is
  # read-only by construction.
  mkdir -p "$STATE_DIR" || return 1
  exec 9>"$LOCKFILE"
  flock -n 9 || return 0

  local wait
  for wait in 0 "${BACKOFF[@]}"; do
    ((wait > 0)) && sleep "$wait"
    if fetch_once; then
      pkill -RTMIN+$SIGNAL waybar 2>/dev/null || true
      return 0
    fi
  done
  return 1
}

# --- rendering --------------------------------------------------------------

# The glyph table below is copied byte-for-byte from omarchy-weather-icon, which
# cannot be reused directly because it does its own fetch. `--check-icons`
# compares the two so an upstream change is caught rather than silently
# diverging - the drift risk ADR-0028 is about.
#
# It is left unindented on purpose, despite sitting inside a function: that keeps
# `--check-icons` an exact diff against upstream. Do not tidy it. It was spliced
# in with sed rather than retyped, because a mistyped Nerd Font glyph is
# invisible in review.
#
# Day or night is decided here at render time, not at fetch time, from the
# cached sunrise/sunset. So the icon still turns from sun to moon at sunset
# while the network is down and the reading itself is hours old.
icon_for() {
  local weather_code=$1 sunrise=$2 sunset=$3
  local night=false icon now_epoch sunrise_epoch sunset_epoch

  now_epoch=$(date +%s)
  sunrise_epoch=$(date -d "today $sunrise" +%s 2>/dev/null || echo 0)
  sunset_epoch=$(date -d "today $sunset" +%s 2>/dev/null || echo 0)

  if ((sunrise_epoch > 0 && sunset_epoch > 0 && (now_epoch < sunrise_epoch || now_epoch >= sunset_epoch))); then
    night=true
  fi

case $weather_code in
  113) [[ $night == "true" ]] && icon="" || icon="" ;;
  116) [[ $night == "true" ]] && icon="" || icon="" ;;
  119|122) icon="" ;;
  143|248|260) icon="" ;;
  176|263|353) [[ $night == "true" ]] && icon="" || icon="" ;;
  179|227|230|323|326|368) [[ $night == "true" ]] && icon="" || icon="" ;;
  182|185|281|284|311|314|317|320|350|362|365|374|377) icon="" ;;
  200|386|389|392|395) icon="" ;;
  266|293|296|299|302|305|308|356|359) icon="" ;;
  329|332|335|338|371) icon="" ;;
  *) icon="" ;;
esac

  printf '%s' "$icon"
}

# wttr.in's arrow points where the wind is going, not where it comes from.
# Calibrated against the live service: 253 degrees (WSW, i.e. blowing towards
# the east) renders as a rightward arrow, so the glyph tracks (degrees + 180).
wind_arrow() {
  local deg=$1 idx
  local arrows=(↑ ↗ → ↘ ↓ ↙ ← ↖)
  [[ $deg =~ ^[0-9]+$ ]] || { printf ''; return; }
  idx=$((((deg + 180) % 360 + 22) / 45 % 8))
  printf '%s' "${arrows[idx]}"
}

# Load the cache into the caller's scope. A cache that will not parse is deleted
# rather than worked around, so the next poll refetches instead of the bar being
# permanently wedged on one bad file.
read_cache() {
  [[ -s $CACHE ]] || return 1

  IFS=$'\t' read -r code temp wind winddir place sunrise sunset fetched < <(
    jq -r '[.code, .temp, .wind, .winddir, .place, .sunrise, .sunset, .fetched] | @tsv' "$CACHE" 2>/dev/null
  )

  if [[ -z ${code:-} || $code == "null" ]]; then
    rm -f "$CACHE"
    return 1
  fi
}

age_of() { echo $(($(date +%s) - fetched)); }

# Refresh if the reading is missing or past its TTL. Detached from this process
# so Waybar's exec returns immediately with whatever is already known.
maybe_refresh() {
  local fresh=$1
  [[ $fresh == true ]] && return 0
  setsid "$0" --refresh >/dev/null 2>&1 &
}

cmd_bar() {
  local code temp wind winddir place sunrise sunset fetched
  local icon class age fresh=false

  if ! read_cache; then
    # Nothing has ever been fetched - a new machine, or a first login that has
    # not reached the network yet. There is nothing honest to draw, so fall back
    # to upstream's behaviour of an empty module for this one poll.
    maybe_refresh false
    printf '{"text":"","class":"unavailable"}\n'
    return
  fi

  age=$(age_of)
  ((age < TTL)) && fresh=true
  maybe_refresh "$fresh"

  icon=$(icon_for "$code" "$sunrise" "$sunset")
  class=$( ((age > STALE_AFTER)) && echo stale || echo current)

  # No tooltip key: the module deliberately answers a click with a notification
  # instead of a hover tooltip (ADR-0029), and config.jsonc keeps tooltips off.
  jq -cn --arg text "$icon" --arg class "$class" '{text: $text, class: $class}'
}

status_line() {
  local a
  a=$(wind_arrow "$winddir")
  printf '%s    %s  ·  Temp %s°F  ·  Wind %s%smph' \
    "$(icon_for "$code" "$sunrise" "$sunset")" "$place" "$temp" "$a" "$wind"
}

cmd_status() {
  local code temp wind winddir place sunrise sunset fetched age

  read_cache || { echo "Weather unavailable"; return 1; }

  age=$(age_of)
  # Say so rather than presenting an old reading as current. Under TTL the
  # number is what the bar is drawing, so the age is noise.
  if ((age > TTL)); then
    printf '%s  ·  %dmin old\n' "$(status_line)" "$((age / 60))"
  else
    status_line
    echo
  fi
}

# Detects the glyph table drifting from upstream after `omarchy update`. The
# block is spliced in unindented so this stays an exact diff.
cmd_check_icons() {
  local mine theirs upstream
  upstream=$(command -v omarchy-weather-icon) || {
    echo "weather-icon: omarchy-weather-icon not on PATH" >&2
    return 2
  }
  # shellcheck disable=SC2016  # $weather_code is the literal text sed matches
  mine=$(sed -n '/^case \$weather_code in/,/^esac$/p' "$0")
  # shellcheck disable=SC2016  # same literal match against upstream's source
  theirs=$(sed -n '/^case \$weather_code in/,/^esac$/p' "$upstream")

  if [[ -z $theirs ]]; then
    echo "weather-icon: could not read the glyph table from $upstream" >&2
    return 2
  fi
  if [[ $mine == "$theirs" ]]; then
    echo "weather-icon: glyph table matches $upstream"
    return 0
  fi
  echo "weather-icon: glyph table has drifted from $upstream" >&2
  diff <(printf '%s\n' "$theirs") <(printf '%s\n' "$mine") >&2
  return 1
}

case ${1:-} in
"") cmd_bar ;;
--status) cmd_status ;;
--refresh) refresh ;;
--check-icons) cmd_check_icons ;;
-h | --help)
  echo "usage: weather-icon [--status|--refresh|--check-icons]"
  ;;
*)
  echo "weather-icon: unknown option '$1'" >&2
  exit 2
  ;;
esac
