#!/bin/bash

# The Claude usage Reading, as a notification (shokupan-plugins ADR-0039, option
# 1). The bar chip is gone; this is what the launcher's "Claude Usage" entry
# runs. Since r1744 it reuses upstream's collector —
# omarchy-agent-usage-claude, the same record the omarchy.agents bar widget
# reads (a widget this rice does not mount, per shokupan-plugins ADR-0039) —
# and renders it with notify-send. The old model-usage scanner this wrapped was
# deleted in the r1744 rename to "agents". The collector's record is a superset
# of the old scanner's: today's tokens by model, sessions, prompts, the
# seven-day history, AND the plan-limit percentages from the OAuth side — the
# part shokupan-plugins ADR-0039 wrote off as not worth reimplementing in bash.
# Upstream did it, so the notification shows it.

set -uo pipefail

COLLECTOR=/usr/share/omarchy/bin/omarchy-agent-usage-claude

[[ -x $COLLECTOR ]] || { notify-send -u critical "Claude Usage" "collector missing: $COLLECTOR"; exit 1; }

python3 - "$COLLECTOR" <<'PY'
import json, subprocess, sys

out = subprocess.run([sys.argv[1]], capture_output=True, text=True, timeout=120)
if out.returncode != 0:
    subprocess.run(["notify-send", "-u", "critical", "Claude Usage",
                    f"collector failed: {out.stderr.strip()[:120]}"])
    sys.exit(1)

d = json.loads(out.stdout)

def human(n):
    for div, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= div:
            return f"{n / div:.1f}{suffix}"
    return str(n)

models = sorted(d.get("todayTokensByModel", {}).items(), key=lambda kv: -kv[1])
per_model = "  ".join(f"{name.replace('claude-', '')} {human(count)}" for name, count in models) or "no activity"

days = d.get("recentDays", [])[-7:]
peak = max((day.get("messageCount", 0) for day in days), default=0) or 1
blocks = "▁▂▃▄▅▆▇█"
spark = "".join(blocks[min(7, int(day.get("messageCount", 0) / peak * 7))] for day in days)

limits = "  ".join(f"{l['label']} {round(l.get('percent', 0) * 100)}%"
                   for l in d.get("limits", [])) or None

body = (f"Today: {human(d.get('todayTotalTokens', 0))} tokens - "
        f"{d.get('todaySessions', 0)} sessions, {d.get('todayPrompts', 0)} prompts\n"
        f"{per_model}\n"
        f"7 days: {spark}")
if limits:
    body += f"\nLimits: {limits}"

subprocess.run(["notify-send", "-u", "low", "-i", "utilities-system-monitor",
                "Claude Usage", body])
PY
