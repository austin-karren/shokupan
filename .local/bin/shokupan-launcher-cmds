#!/bin/bash

# loaf:summary=Regenerate the launcher's command entries (.desktop files + glyph icons)

# ADR-0027's merged app+command list, rebuilt for quattro. The launcher reads
# exactly one model — DesktopEntries.applications.values (Launcher.qml) — so the
# way commands join the applications is to BE applications: each command below is
# rendered to .local/share/applications/shokupan-cmd-<slug>.desktop in the repo,
# where it is tracked and stowed like the web apps.
#
# The output is tracked, not generated at heal time. Tracked files are what
# `loaf heal` defends (ADR-0028), a diff shows exactly which entries changed, and
# the conditional entries (Sleep, Hibernate) get their conditions evaluated here,
# once, on the machine they describe. Re-run this script after editing the table
# below, then commit what changed.
#
# GLYPHS. The launcher's icon slot takes a file path (Launcher.qml iconSource(),
# absolute path branch), so each entry's Nerd Font glyph is rendered to a PNG at
# generation time. Codepoints live in this file as hex — never as literal glyphs,
# which is the same editor-loss trap palette.lua and omarchy-menu.jsonc both
# document. Rendering fails loudly if a font lacks the codepoint (tofu check).
#
# ABSOLUTE PATHS in Exec. Quickshell executes entries without a login
# environment: ~/.local/bin is not on PATH. Upstream never notices because its
# commands live in /usr/share/omarchy/bin, which is baked into the session PATH.
# Ours would fail silently — same trap the bar modules and menu extension hit.

set -euo pipefail

LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"
export LOAF_HOME LOAF_ROOT

exec python3 - <<'PY'
import os, subprocess, sys

HOME = os.environ["LOAF_HOME"]
ROOT = os.environ["LOAF_ROOT"]
APPS = os.path.join(ROOT, ".local/share/applications")
ICONS = os.path.join(APPS, "icons", "cmd")
OBIN = "/usr/share/omarchy/bin"
LBIN = f"{HOME}/.local/bin"

# Icon= must point at the stowed path, not the repo path: the entry is consumed
# from ~/.local/share/applications, and a repo path would break if the checkout
# moved. The icon files themselves are tracked, so the symlink always resolves.
ICON_AT = f"{HOME}/.local/share/applications/icons/cmd"

def toggles(name):
    return os.path.exists(f"{HOME}/.local/state/omarchy/toggles/{name}")

def cmd_ok(c):
    return subprocess.run([c], capture_output=True).returncode == 0

# (slug, label, codepoint, keywords, exec, comment, include?)
# Labels and glyphs are the pre-quattro palette's (Omarchy's names win, per
# ADR-0027). Exec strings are quattro-era: omarchy-toggle-waybar became
# omarchy-toggle-bar; the deleted monitor-scaling-cycle became up/down rows
# (mirroring the menu extension's "two rows are the honest shape"); walker's
# symbols/clipboard modes became shell IPC toggles; omarchy-menu routes are
# quattro ids — an action id (style.theme) runs directly, a submenu id opens.
ENTRIES = [
    ("screensaver",      "Screensaver",            0xF1104, "screensaver;idle;toggle",                        f"{OBIN}/omarchy-toggle-screensaver", "Toggle the screensaver on or off", True),
    ("nightlight",       "Nightlight",             0xF050E, "night;blue light;warm;toggle",                   f"{OBIN}/omarchy-toggle-nightlight", "Toggle the warm-colour night filter", True),
    ("idle-lock",        "Idle Lock",              0xF1AD6, "idle;lock;sleep;toggle",                         f"{OBIN}/omarchy-toggle-idle", "Toggle locking when idle", True),
    ("notifications",    "Notifications",          0xF009B, "dnd;do not disturb;silence;toggle",              f"{OBIN}/omarchy-toggle-notification-silencing", "Toggle notification silencing", True),
    ("top-bar",          "Top Bar",                0xF035C, "bar;panel;waybar;toggle",                        f"{OBIN}/omarchy-toggle-bar", "Show or hide the bar", True),
    ("workspace-layout", "Workspace Layout",       0xF10AC, "tiling;dwindle;master;toggle",                   f"{OBIN}/omarchy-hyprland-workspace-layout-toggle", "Cycle the tiling layout", True),
    ("window-gaps",      "Window Gaps",            0xE62A,  "gaps;spacing;toggle",                            f"{OBIN}/omarchy-hyprland-window-gaps-toggle", "Toggle gaps between windows", True),
    ("zen-ratio",        "1-Window Zen Ratio",     0xF2D0,  "zen;aspect;ratio;single window;toggle",          f"{LBIN}/ratio-toggle", "Toggle the 6:5 single-window ratio (ADR-0026)", True),
    ("scale-up",         "Monitor Scale Up",       0xF0415, "scale;hidpi;bigger;zoom",                        f"{OBIN}/omarchy-hyprland-monitor-scaling up", "Increase monitor scaling", True),
    ("scale-down",       "Monitor Scale Down",     0xF0374, "scale;hidpi;smaller;zoom",                       f"{OBIN}/omarchy-hyprland-monitor-scaling down", "Decrease monitor scaling", True),
    ("direct-boot",      "Direct Boot",            0xF03A,  "boot;grub;skip",                                 f"{OBIN}/omarchy-launch-floating-terminal-with-presentation omarchy-config-direct-boot", "Skip the boot menu", True),
    ("passwordless-sudo","Passwordless Sudo",      0xF07F5, "sudo;password",                                  f"{OBIN}/omarchy-launch-floating-terminal-with-presentation omarchy-sudo-passwordless", "Configure passwordless sudo", True),
    ("appearance",       "Toggle Light/Dark",      0xF0594, "dark;light;appearance;mode;theme",               f"{LBIN}/toggle-appearance", "Switch between light and dark appearance", True),
    ("emoji",            "Emoji & Symbols",        0xF01F2, "emoji;symbol;unicode;character",                 f"{OBIN}/omarchy-shell shell toggle omarchy.emojis", "Pick an emoji or symbol", True),
    ("clipboard",        "Clipboard History",      0xF014D, "clipboard;paste;history;copy",                   f"{OBIN}/omarchy-shell shell toggle omarchy.clipboard", "Paste from clipboard history", True),
    ("wallpaper",        "Wallpaper",              0xF0E09, "background;wallpaper",                           f"{OBIN}/omarchy-menu summon style.background", "Pick a background", True),
    ("theme",            "Theme",                  0xF03D8, "theme;colours;colors;appearance",                f"{OBIN}/omarchy-menu summon style.theme", "Pick a theme", True),
    ("install",          "Install",                0xF0249, "install;add;package;software",                   f"{OBIN}/omarchy-menu summon install", "Install packages and services", True),
    ("remove",           "Remove",                 0xF0B4C, "remove;uninstall;delete;package",                f"{OBIN}/omarchy-menu summon remove", "Remove packages and services", True),
    ("update-omarchy",   "Update Omarchy Desktop", 0xF021,  "update;upgrade;omarchy;desktop;shell;bar",       f"{OBIN}/omarchy-menu summon update", "Update the Omarchy desktop layer", True),
    ("update-system",    "Update System",          0xF021,  "update;upgrade;cachyos;arch;pacman;aur;flatpak", f"{OBIN}/omarchy-launch-floating-terminal-with-presentation {LBIN}/system-update", "Update the base system only (ADR-0034)", True),
    ("start-screensaver","Start Screensaver",      0xF1104, "screensaver;blank",                              f"{OBIN}/omarchy-launch-screensaver force", "Start the screensaver now", True),
    ("lock",             "Lock",                   0xF033E, "lock;secure",                                    f"{OBIN}/omarchy-system-lock", "Lock the screen", True),
    ("sleep",            "Sleep",                  0xF04B2, "suspend;sleep",                                  "systemctl suspend", "Suspend to RAM", not toggles("suspend-off")),
    ("hibernate",        "Hibernate",              0xF0901, "hibernate",                                      "systemctl hibernate", "Hibernate to disk", cmd_ok(f"{OBIN}/omarchy-hibernation-available")),
    ("logout",           "Log Out",                0xF0343, "logout;sign out",                                f"{OBIN}/omarchy-system-logout", "End the session", True),
    ("restart",          "Restart",                0xF0709, "reboot;restart",                                 f"{OBIN}/omarchy-system-reboot", "Reboot the machine", True),
    ("shutdown",         "Shut Down",              0xF0425, "shutdown;power off;poweroff",                    f"{OBIN}/omarchy-system-shutdown", "Power the machine off", True),
]

# ---- render glyph icons -----------------------------------------------------
from PIL import Image, ImageDraw, ImageFont
import glob as globmod

SIZE, COLOUR = 64, (154, 160, 170, 255)  # neutral grey, legible on either theme

def font_for(cp):
    # Prefer the propo/mono symbol coverage of the installed Nerd Fonts.
    for pat in ("/usr/share/fonts/TTF/*NerdFont-Regular.ttf",
                "/usr/share/fonts/TTF/*NerdFontMono-Regular.ttf",
                "/usr/share/fonts/**/*Nerd*[Rr]egular*.ttf"):
        for path in sorted(globmod.glob(pat, recursive=True)):
            f = ImageFont.truetype(path, int(SIZE * 0.82))
            if f.getmask(chr(cp)).getbbox():  # font actually has the glyph
                return f, path
    return None, None

os.makedirs(ICONS, exist_ok=True)
made, skipped = [], []
for slug, label, cp, kw, ex, comment, include in ENTRIES:
    if not include:
        skipped.append((slug, label))
        continue
    f, fpath = font_for(cp)
    if f is None:
        sys.exit(f"FATAL: no installed font renders U+{cp:X} ({label}) — refusing to ship tofu")
    img = Image.new("RGBA", (SIZE, SIZE), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.text((SIZE / 2, SIZE / 2), chr(cp), font=f, fill=COLOUR, anchor="mm")
    if not img.getbbox():
        sys.exit(f"FATAL: U+{cp:X} ({label}) rendered blank from {fpath}")
    img.save(os.path.join(ICONS, f"{slug}.png"))

    lines = [
        "[Desktop Entry]",
        "# Generated by shokupan-launcher-cmds — edit the table there, not this file.",
        "Type=Application",
        f"Name={label}",
        f"Comment={comment}",
        f"Exec={ex}",
        f"Icon={ICON_AT}/{slug}.png",
        f"Keywords={kw};",
        "Categories=System;Utility;",
        "Terminal=false",
        "StartupNotify=false",
    ]
    with open(os.path.join(APPS, f"shokupan-cmd-{slug}.desktop"), "w") as fh:
        fh.write("\n".join(lines) + "\n")
    made.append((slug, label))

for slug, label in made:
    print(f"  wrote shokupan-cmd-{slug}.desktop  ({label})")
for slug, label in skipped:
    print(f"  skipped {slug} ({label}) — condition false on this machine")
print(f"{len(made)} entries, {len(skipped)} skipped. Stow installs them; the launcher watches the directory.")
PY
