#!/bin/bash

# Turn an Aether palette into a first-class Omarchy theme.
#
# Aether's own "apply" path takes over ~/.config/omarchy/current directly, which
# makes it awkward to back out of and has two failure modes worth engineering
# around:
#
#   1. A theme applied from a palette-only source (an imported base16 scheme, a
#      blueprint, the GUI without a wallpaper picked) has an EMPTY backgrounds/
#      directory. Under quattro that no longer paints the screen black (the old
#      `swaybg --color '#000000'` fallback died with swaybg; bg-next's TOTAL==0
#      branch now just notifies) - but it still means the theme ships no
#      wallpaper at all, so switching to it visibly does nothing to the screen.
#      Seeding backgrounds/ keeps the generated theme a complete theme.
#
#   2. (Retired.) Aether never wrote Omarchy's `light.mode` marker, so this
#      wrapper did. Quattro removed the marker: mode is the `mode = "light"`
#      line in colors.toml, which Aether writes itself. See below.
#
# So: generate with --no-apply, guarantee a background, and stage it as an
# ordinary named theme under
# ~/.config/omarchy/themes/. From there it is just another Omarchy theme -
# `omarchy theme set` it, switch away, `omarchy theme remove` it. Nothing about
# the live theme is touched until you ask for it.
#
#   aether-theme <name> <wallpaper>     generate and register, do not apply
#   aether-theme <name> <wallpaper> --apply
#                                       ...and switch to it now
#     --light-mode                      generate the light variant
#     --force                           overwrite an existing theme of that name
#   aether-theme --list                 list themes made by this script
#   aether-theme --remove <name>        remove one

set -e

USER_THEMES="$HOME/.config/omarchy/themes"
STOCK_THEMES="${OMARCHY_PATH:-$HOME/.local/share/omarchy}/themes"
MARKER=".made-by-aether-theme"

die() {
  echo "error: $*" >&2
  exit 1
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'
}

case "$1" in
--list)
  found=0
  for d in "$USER_THEMES"/*/; do
    [[ -f $d$MARKER ]] || continue
    echo "$(basename "$d")  (from $(cat "$d$MARKER"))"
    found=1
  done
  (( found )) || echo "No themes generated by aether-theme."
  exit 0
  ;;
--remove)
  [[ -n $2 ]] || die "usage: aether-theme --remove <name>"
  slug=$(slugify "$2")
  [[ -d $USER_THEMES/$slug ]] || die "no such theme: $slug"
  [[ -f $USER_THEMES/$slug/$MARKER ]] ||
    die "$slug was not created by aether-theme - remove it with: omarchy theme remove $slug"
  # Quattro moved this pointer from ~/.config/omarchy/current/ to
  # ~/.local/state/omarchy/current/. Under the old path the guard read an
  # absent file, compared empty to the slug, and never fired - which made
  # `aether-theme --remove <current theme>` an rm -rf of the LIVE theme.
  if [[ $(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null) == "$slug" ]]; then
    die "$slug is the current theme - switch away first (omarchy theme set ...)"
  fi
  # :? on both halves — this is the only rm -rf in the rice, and an empty
  # variable here would aim it at / instead of a theme directory.
  rm -rf "${USER_THEMES:?}/${slug:?}"
  echo "Removed theme: $slug"
  exit 0
  ;;
esac

NAME="$1"
WALLPAPER="$2"
shift 2 || die "usage: aether-theme <name> <wallpaper> [--light-mode] [--apply] [--force]"

[[ -n $NAME ]] || die "a theme name is required"
[[ -n $WALLPAPER && -f $WALLPAPER ]] || die "not a file: ${WALLPAPER:-<none>}"

LIGHT=0 APPLY=0 FORCE=0
for arg in "$@"; do
  case "$arg" in
  --light-mode | --light) LIGHT=1 ;;
  --apply) APPLY=1 ;;
  --force) FORCE=1 ;;
  *) die "unknown option: $arg" ;;
  esac
done

SLUG=$(slugify "$NAME")
DEST="$USER_THEMES/$SLUG"

# Never shadow a stock theme: omarchy-theme-set copies the stock theme first and
# then overlays the user one on top, so a name collision silently mixes the two.
[[ -d $STOCK_THEMES/$SLUG ]] && die "'$SLUG' is a stock Omarchy theme - pick another name"

if [[ -d $DEST && $FORCE -eq 0 ]]; then
  die "theme '$SLUG' already exists - pass --force to overwrite"
fi

# Stage into a temp dir so a failed generate cannot leave a half-written theme
# registered (the same reason omarchy-theme-set builds current/next-theme first).
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

gen_args=(--generate "$WALLPAPER" --no-apply --output "$STAGE")
(( LIGHT )) && gen_args+=(--light-mode)

echo "Generating palette from $(basename "$WALLPAPER")..."
aether "${gen_args[@]}" >/dev/null

[[ -f $STAGE/colors.toml ]] || die "aether produced no colors.toml - refusing to register a broken theme"

# Gotcha 1: guarantee a background so bg-next can never fall back to black.
mkdir -p "$STAGE/backgrounds"
if [[ -z $(find "$STAGE/backgrounds" -maxdepth 1 -type f -print -quit) ]]; then
  cp -f "$WALLPAPER" "$STAGE/backgrounds/"
  echo "  seeded backgrounds/ with $(basename "$WALLPAPER")"
fi

# Gotcha 2 RETIRED under quattro: the light.mode marker file is gone from the
# theme format. A theme's mode is now the `mode = "light"` line in colors.toml -
# which Aether already writes, so there is nothing left to fill in. (The old
# marker was consumed by the Waybar override hook; both died in the upgrade.)

basename "$WALLPAPER" >"$STAGE/$MARKER"

mkdir -p "$USER_THEMES"
rm -rf "$DEST"
mv "$STAGE" "$DEST"
chmod 755 "$DEST"
trap - EXIT

echo "Registered theme: $SLUG"

if (( APPLY )); then
  omarchy-theme-set "$SLUG"
  echo "Applied: $SLUG"
else
  echo "Try it with:  omarchy theme set \"$NAME\""
fi

# A pinned wallpaper outranks whatever the theme ships (see
# theme-set.d/30-restore-wallpaper), so say so rather than letting it look broken.
if [[ -f $HOME/.local/state/omarchy/wallpaper-pin ]]; then
  echo
  echo "Note: a wallpaper is pinned, so it will override this theme's background."
  echo "      Run 'pin-wallpaper --off' to let theme wallpapers through again."
fi
