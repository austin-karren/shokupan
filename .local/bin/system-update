#!/bin/bash

# Update everything — CachyOS and Arch packages, the AUR, and Flatpaks — while
# watching it happen.
#
# This used to be "the base, without touching Omarchy", the other half of a base /
# desktop split (ADR-0034). Under quattro that split is gone: Omarchy is distro
# packages now (ADR-0035), so `pacman -Syu` upgrades omarchy-dev like anything
# else, and `omarchy update` no longer pulls a checkout — it IS a full system
# upgrade with migrations and hooks attached.
#
# What still separates the two is attendance, and that is why this one survives.
# Omarchy's updater runs `pacman -Syu --noconfirm` with 25 `--overwrite` paths
# through /etc, including sddm.conf.d, sudoers.d and mkinitcpio.conf.d. This runs
# interactively, so replacements and .pacnew warnings are on screen where someone
# can read them — which is the whole point on a machine whose base was installed
# by somebody other than Omarchy.
#
# It skips omarchy-migrate and the post-update hooks; `loaf heal` at the end is
# this side's equivalent.
#
# Launch it from the System Palette ("Update System"), which wraps it in Omarchy's
# floating terminal presentation.

set -uo pipefail

step() { printf '\n\e[32m%s\e[0m\n' "$1"; }
skip() { printf '\n\e[33m%s\e[0m\n' "$1"; }

# Same confirmation shape as omarchy-update-confirm, for the same reason: this is a
# long, uninterruptible operation and the screen is the last chance to back out.
# Deliberately not a call to that script -- its copy names Omarchy's releases page
# and warns about Omarchy's update, neither of which is true here.
if command -v gum &>/dev/null; then
  gum style --border normal --padding "1 2" \
    "Ready to update the system?" \
    "" \
    "• CachyOS and Arch packages, the AUR, and Flatpaks" \
    "• Omarchy is packages now, so it updates too — this is the attended path" \
    "• Skips Omarchy's migrations and hooks — 'Update Omarchy Desktop' runs those" \
    "• You cannot stop the update once it starts" \
    "" \
    "Pacman will prompt before replacing anything. Read those." \
    "" \
    "Answering the AUR rebuild prompts can take a while."

  echo

  if ! gum confirm "Continue with update?"; then
    echo "Update cancelled"
    exit 1
  fi
fi

failed=()

step "Update system packages"
# Quattro installs 00-omarchy-update-guard.hook, a PreTransaction pacman hook with
# AbortOnFail that refuses a direct `pacman -Syu` unless OMARCHY_ALLOW_DIRECT_PACMAN=1
# (ADR-0035). That hook is installed on this machine now, so this is load-bearing
# rather than a precaution — without it, every step below is unreachable.
if sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu; then :; else failed+=("pacman"); fi

# Boot contract (ADR-0047): when omarchy's hooks file selects the busybox
# `encrypt` flavour, every cmdline in the rendered boot menu must carry
# cryptdevice= or the next boot cannot unlock root — the r1744 upgrade proved
# it with a live-USB recovery. The menu is root-only, so this deep half of
# `loaf doctor`'s no-sudo check lives here, where sudo is already warm and a
# kernel/initramfs rebuild may just have happened.
if grep -qE '^HOOKS=.*[( ]encrypt[ )]' /etc/mkinitcpio.conf.d/omarchy_hooks.conf 2>/dev/null &&
  grep -qE 'rd\.luks\.uuid=|root=/dev/mapper/' /proc/cmdline; then
  step "Verify the boot menu can unlock LUKS"
  cmdlines_total=$(sudo grep -c '^\s*cmdline:' /boot/limine.conf 2>/dev/null || echo 0)
  cmdlines_ok=$(sudo grep '^\s*cmdline:' /boot/limine.conf 2>/dev/null | grep -c 'cryptdevice=' || true)
  if ((cmdlines_total > 0 && cmdlines_ok == cmdlines_total)); then
    echo "all $cmdlines_total menu cmdline(s) carry cryptdevice="
  else
    failed+=("boot-contract")
    printf '\e[31m%s of %s boot menu cmdlines lack cryptdevice= — do NOT reboot until fixed (ADR-0047)\e[0m\n' \
      "$((cmdlines_total - cmdlines_ok))" "$cmdlines_total"
  fi
fi

if command -v yay &>/dev/null; then
  step "Update AUR packages"
  # --devel would also rebuild -git packages against their upstream HEAD, which
  # turns a routine update into an unbounded build. Left off deliberately.
  yay -Sua || failed+=("aur")
else
  skip "No AUR helper found — skipping AUR"
fi

if command -v flatpak &>/dev/null; then
  step "Update flatpaks"
  flatpak update || failed+=("flatpak")
else
  skip "Flatpak not installed — skipping"
fi

# The rice sits on top of all of it, and a package update can displace a symlink
# (ADR-0028). Re-assert it here so the update ends with the desktop in a known
# state rather than leaving it to the next `omarchy update` hook.
if command -v loaf &>/dev/null; then
  step "Re-assert the rice"
  loaf heal
fi

if ((${#failed[@]})); then
  printf '\n\e[31mFinished with problems in: %s\e[0m\n' "${failed[*]}"
  printf 'Run \e[1mloaf doctor\e[0m once they are resolved.\n'
  exit 1
fi

step "Done"
printf 'Run \e[1mloaf doctor\e[0m to confirm all three layers agree.\n'
