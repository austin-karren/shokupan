#!/bin/bash
# The clock's left click, dialog-aware (ADR-0006): when the GNOME Calendar
# popup is up, clicking the clock CLOSES it — a dialog's summoner is also its
# dismisser — instead of stacking the omarchy month panel on top. With no
# popup up, stock behavior: toggle the panel (IPC to omarchy.clock, which the
# plugin registry routes to the austinkarren.clock clone).
#
# A script rather than QML because the popup's visibility lives in Hyprland,
# which QML can't ask synchronously; the clone's BarWidget runs this by
# absolute path (quickshell's bash -lc has no ~/.local/bin on PATH).

set -u

WS="calendar"

if hyprctl monitors -j | jq -e --arg ws "special:$WS" 'any(.[]; .specialWorkspace.name == $ws)' >/dev/null; then
  "$HOME/.local/bin/calendar-toggle"
else
  omarchy-shell -q shell toggle omarchy.clock
fi
