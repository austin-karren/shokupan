#!/bin/bash
# Hide the calendar popup when focus leaves it (ADR-0006 addendum).
#
# hide_special_on_workspace_change only dismisses on a workspace SWITCH;
# clicking another window on the same workspace leaves the popup hanging. This
# listens on Hyprland's event socket (socket2) for activewindow events and
# hides special:calendar when focus lands on a non-calendar window.
#
# No busy loop: socat blocks on the socket and the shell blocks on read, so the
# loop wakes once per focus change. The spawned work is at most one visibility
# check per non-calendar focus event; visible() gates the dispatch so a hidden
# popup costs a single hyprctl and no dispatch.

set -u

CLASS="org.gnome.Calendar"
WS="calendar"
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

visible() {
  hyprctl monitors -j | jq -e --arg ws "special:$WS" 'any(.[]; .specialWorkspace.name == $ws)' >/dev/null
}

# Supervised: socat exits if the socket hiccups (compositor reload, event
# storm disconnect), and an unsupervised exit turns click-outside-to-close
# off silently until the next login. Respawn with a backoff; give up only
# when Hyprland itself is gone.
while [[ -S $SOCKET ]]; do
  socat -U - "UNIX-CONNECT:$SOCKET" | while IFS= read -r line; do
    case "$line" in
    "activewindow>>$CLASS,"*) ;; # focus went to the calendar itself: keep it
    "activewindow>>,"*)
      # Empty class fires BOTH when the user clicks the bare desktop (should
      # hide — the measured gap in click-outside) and transiently while the
      # popup is opening, before the calendar takes focus (must not hide).
      # Grace: wait a beat, then hide only if nothing took focus meanwhile
      # and the popup is still up.
      if visible; then
        sleep 0.3
        cls=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')
        if [[ $cls != "$CLASS" && ( -z $cls || $cls == "null" ) ]] && visible; then
          hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$WS\")" >/dev/null
        fi
      fi
      ;;
    "activewindow>>"*)
      visible && hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$WS\")" >/dev/null
      ;;
    esac
  done
  sleep 2
done
