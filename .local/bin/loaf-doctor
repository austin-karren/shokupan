#!/bin/bash

# loaf:summary=Check the three layers for drift, without changing anything

# This machine is three layers deep: CachyOS is the base, Omarchy is the desktop
# layered on top of it as distro packages (ADR-0035), and the rice sits on top of
# both. Each layer updates on its own schedule and can quietly undo the one above
# it, so this asserts what should be true and reports what is not.
#
# Read-only by construction: it never writes, never sudos, and never touches the
# network. `loaf heal` is the half that fixes things. Exits non-zero if anything
# is wrong, so it can gate a hook.

set -uo pipefail

# $LOAF_HOME is $HOME everywhere except the test suite, which points it at a
# fixture tree. Every path below derives from it, so nothing reaches the real
# home directory unless it was asked to.
LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"
# Sibling loaf-* commands resolve relative to this script, not to a PATH that
# may not contain ~/.local/bin yet — on a fresh machine the symlinks only land
# after the first stow pass. Measured in the lab: heal silently skipped debloat.
PATH="$(dirname "$(realpath "$0")"):$PATH"

# Tracked paths that are repo furniture, not config, and so must never be
# symlinked into the home directory. This has to agree with .stow-local-ignore
# — they answer the same question from opposite ends, and when they disagree
# doctor reports a file as missing that stow was never going to install. The
# test suite asserts they stay in step.
REPO_ONLY='^(lab/|docs/|packages/|migrations/|test/|README|CONTEXT|packages\.txt|\.gitignore|\.stow-local-ignore)'
STATE_DIR="${XDG_STATE_HOME:-$LOAF_HOME/.local/state}/loaf"

# Omarchy is package-backed at a fixed path now, so this is a constant rather
# than something to discover. $OMARCHY_PATH is still read, because `omarchy dev
# link` repoints it at a source checkout — a legitimate state, but one where the
# installed package is not what is live.
OMARCHY_PKG_ROOT=/usr/share/omarchy
OMARCHY_ROOT="${OMARCHY_PATH:-$OMARCHY_PKG_ROOT}"

# The base checks below read files under /etc, which is neither writable nor
# predictable from a test. They are injectable for the same reason every path
# derives from $LOAF_HOME: so the suite asserts against a fixture rather than
# against whatever the machine running it happens to be configured with.
PACMAN_CONF="${PACMAN_CONF:-/etc/pacman.conf}"
MIRRORLIST="${MIRRORLIST:-/etc/pacman.d/mirrorlist}"
NM_CONF="${NM_CONF:-/etc/NetworkManager/NetworkManager.conf}"

problems=0

layer() { printf '\n\033[1m%s\033[0m\n' "$1"; }

ok() { printf '  \033[32m✓\033[0m %-14s %s\n' "$1" "${2:-}"; }

bad() {
  problems=$((problems + 1))
  printf '  \033[31m✗\033[0m %-14s %s\n' "$1" "$2"
  local detail
  for detail in "${@:3}"; do printf '    %s\n' "$detail"; done
}

warn() { printf '  \033[33m!\033[0m %-14s %s\n' "$1" "$2"; }

# ---------------------------------------------------------
# Base — CachyOS
# ---------------------------------------------------------

# The bridge that originally put Omarchy on this base is retired (ADR-0035), and
# its three sentinels went with it: `bridge patch` and `stale clone` guarded an
# installer that will never run again, and `walker hold` guarded a Walker that
# quattro does not ship. Deleted rather than left warning, per ADR-0028 —
# tolerated noise stops being read.
#
# What replaces them is `mirrorlist`, which guards the one thing measured to
# actually destroy this base.

layer "Base (CachyOS)"

# Omarchy is a DESKTOP layer here and nothing more. The base is CachyOS, and the
# base is not Omarchy's to manage -- see ADR-0034.
#
# The specific hazard: `omarchy-channel-set` calls `omarchy-refresh-pacman`, which
# does `cp -f $OMARCHY_PATH/default/pacman/pacman-<channel>.conf /etc/pacman.conf`
# and then `pacman -Syyuu --noconfirm`. That replaces the repo list with Omarchy's
# vanilla-Arch one and the second `u` permits DOWNGRADES, so every znver4-optimised
# package rolls back to stock Arch and linux-cachyos loses its repo. It nearly ran
# on this machine on 2026-08-08 and was stopped only by an unrelated failure
# short-circuiting the `&&`.
#
# A PATH shim cannot guard this: Omarchy's bin sits ahead of ~/.local/bin in PATH
# (index 2 vs 14), so a same-named script here would never be reached. Hence a
# check, which at least makes the damage loud and immediate.

if [[ -f $PACMAN_CONF ]]; then
  cachyos_repos=$(grep -c '^\[cachyos' "$PACMAN_CONF" 2>/dev/null || echo 0)
  if ((cachyos_repos >= 1)); then
    ok "repos" "$cachyos_repos CachyOS repo section(s)"
  else
    bad "repos" "no CachyOS repos in $PACMAN_CONF" \
      "the base has been replaced with stock Arch — restore $PACMAN_CONF.bak" \
      "then re-add the [cachyos*] sections; do NOT run omarchy-channel-set"
  fi
fi

# The measured root cause of the quattro upgrade's near-miss (ADR-0035). Omarchy's
# `configure_pacman_channel` overwrites the mirrorlist with a single
# `Server = https://stable-mirror.omarchy.org/...`, which is a FROZEN Arch snapshot.
# CachyOS tracks Arch rolling, so pinning core/extra to that snapshot puts the two
# halves of the system into permanent version skew and pacman starts refusing
# partial downgrades. It presented as an unrelated aquamarine ABI conflict and was
# not; restoring the rolling mirrorlist collapsed the whole thing.
#
# Unguarded until now, and — alongside omarchy-channel-set — the remaining way the
# base gets destroyed. `[cachyos*]` surviving in pacman.conf does not imply the
# mirrorlist did: the upgrade's pacman.conf edit is a surgical awk that leaves the
# repo list alone while the mirrorlist is replaced wholesale.
if [[ -f $MIRRORLIST ]]; then
  if grep -qE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https?://[a-z-]*mirror\.omarchy\.org/' \
    "$MIRRORLIST" 2>/dev/null; then
    bad "mirrorlist" "$MIRRORLIST points at an Omarchy mirror" \
      "that mirror is a frozen Arch snapshot; CachyOS is rolling — the two will skew" \
      "restore the CachyOS mirrorlist (cachyos-rate-mirrors), then reconcile with pacman -Syu"
  else
    ok "mirrorlist" "$(grep -cE '^[[:space:]]*Server' "$MIRRORLIST" 2>/dev/null) mirror(s), none from omarchy.org"
  fi
fi

# NetworkManager delegates wifi to a backend it does not itself provide, and says
# nothing when the one it was told to use is absent — the device simply reports
# `unavailable` and scans nothing. On a machine that lives on ethernet that is
# invisible.
#
# This is the check ADR-0034 wrote as "warns if wifi.backend=iwd is gone", which
# quattro made not merely stale but actively misleading: it went on reporting ✓
# after quattro's `pacman -Rns` removed iwd on 2026-08-09, because the stanza
# naming iwd was still there. It asserted a bridge side effect rather than
# anything true about this machine.
#
# So it neither inverts nor goes. Inverting — warning when iwd IS set — would
# assert quattro's preference and nag a machine where iwd was deliberately
# reinstalled and works. The invariant that survives either resolution is that
# the configured backend exists. Backend names match their package names for the
# two NetworkManager accepts (`iwd`, `wpa_supplicant`).
if [[ -f $NM_CONF ]]; then
  wifi_backend=$(sed -n 's/^[[:space:]]*wifi\.backend[[:space:]]*=[[:space:]]*//p' "$NM_CONF" | head -1)
  if [[ -z $wifi_backend ]]; then
    # No stanza is not a problem: NetworkManager falls back to wpa_supplicant,
    # which is what quattro leaves it on.
    ok "wifi backend" "NetworkManager default (wpa_supplicant)"
  elif pacman -Qq "$wifi_backend" &>/dev/null; then
    ok "wifi backend" "$wifi_backend"
  else
    bad "wifi backend" "wifi.backend=$wifi_backend, but $wifi_backend is not installed" \
      "NetworkManager has no wifi backend — the device will report unavailable and never scan" \
      "either reinstall $wifi_backend, or drop the [device] stanza from $NM_CONF" \
      "to fall back to wpa_supplicant"
  fi
fi

if [[ $(uname -r) == *cachyos* ]]; then
  ok "kernel" "$(uname -r)"
else
  warn "kernel" "running $(uname -r) — not a CachyOS kernel"
fi

# ---------------------------------------------------------
# Desktop — Omarchy
# ---------------------------------------------------------

layer "Desktop (Omarchy)"

# Omarchy used to be a git checkout at ~/.local/share/omarchy, and this asked
# whether that checkout was intact. Under quattro it is distro packages at
# /usr/share/omarchy (ADR-0035), so there is no tree to describe, nothing to be
# dirty, and no `git pull` to revert a local edit. Three checks went with it:
#
#   `checkout`      — became this, an assertion about the package
#   the porcelain   — deleted; there is no worktree to have unexpected edits in
#   `cachyos patch` — deleted. It asserted two bridge `sed`s inside the checkout.
#                     Quattro ships that package list INSIDE the omarchy package,
#                     so any edit to it is reverted by the next upgrade — a check
#                     that must eventually fail on a healthy machine.
#
# `pacman -Q omarchy` rather than a hardcoded package name: this machine carries
# `omarchy-dev`, which `Provides: omarchy`, and pacman resolves that.
omarchy_version=$(pacman -Q omarchy 2>/dev/null | awk '{print $2}')
if [[ -n $omarchy_version ]]; then
  ok "package" "omarchy $omarchy_version"
else
  bad "package" "no omarchy package installed" \
    "the desktop layer is gone — reinstall omarchy (or omarchy-dev) from the [omarchy] repo"
fi

# Emergency mode outlives its cause. A config file missing for even a moment —
# measured 2026-08-10, when a restow window left hyprland.lua absent exactly as
# Hyprland reloaded — registers no binds and trips emergency mode, and the
# banner then stays up after the file is back: nothing re-reads the config
# until an explicit `hyprctl reload`. Doctor at that moment showed all green,
# because the symlinks WERE healthy. So ask the compositor itself.
#
# The newest socket directory is the live instance: a compositor restart mints
# a new signature and the stale directories linger, so the environment's
# $HYPRLAND_INSTANCE_SIGNATURE (inherited from before the restart) cannot be
# trusted — also measured. Skipped entirely when no runtime dir exists: a TTY,
# an SSH session on a headless box, and the test fixtures all have none, and
# "no compositor" is not a config error.
HYPR_RUNTIME_DIR="${HYPR_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr}"
if command -v hyprctl &>/dev/null && [[ -d $HYPR_RUNTIME_DIR ]]; then
  # shellcheck disable=SC2012  # signatures are plain dir names; mtime order is the point
  hypr_sig=$(ls -t "$HYPR_RUNTIME_DIR" 2>/dev/null | head -1)
  if [[ -n $hypr_sig ]]; then
    if hypr_errors=$(HYPRLAND_INSTANCE_SIGNATURE="$hypr_sig" hyprctl configerrors 2>/dev/null); then
      # "no errors" is what some hyprctl versions print for a clean config.
      if [[ -z $hypr_errors || $hypr_errors == "no errors" ]]; then
        ok "hyprland" "no config errors"
      else
        mapfile -t hypr_error_lines <<<"$hypr_errors"
        bad "hyprland" "config errors — emergency mode is likely active" \
          "${hypr_error_lines[@]}" \
          "fix the config, then: hyprctl reload"
      fi
    fi
    # A failing hyprctl (socket gone mid-check, ancient version without
    # configerrors) is silence, not a verdict — it cannot tell either way.
  fi
fi

# `omarchy dev link` repoints $OMARCHY_PATH at a source checkout, which is a
# legitimate state but means the version reported above is not what is running.
# Worth saying out loud rather than silently comparing the pin against something
# that is not live.
if [[ $OMARCHY_ROOT != "$OMARCHY_PKG_ROOT" ]]; then
  warn "omarchy path" "OMARCHY_PATH is $OMARCHY_ROOT — a dev checkout is live, not the package"
fi

# Which Omarchy this rice was last VERIFIED against, versus what is installed.
# The rice reaches into upstream's files -- bar modules, menu overrides, window
# rules -- so "does this work" is only answerable together with a version.
#
# The pin is a tracked file, not a tag. It used to be derived from
# `git tag -l 'omarchy-v*' | sort -V | tail -1`, which was wrong twice over.
# One namespace held two kinds of claim, so the rollback point
# omarchy-v3.8.4-prequattro sorted above the actual pin omarchy-v3.8.4 and won.
# And quattro's version string is `4.0.0.r1046.gd570d99-1` — no leading v, and an
# .r<n>.g<sha>-<pkgrel> suffix that sort -V cannot meaningfully order against
# v3.8.4. Ordering was never going to survive package-backing.
#
# A file compares by EQUALITY, so the version's shape stops mattering, and it
# answers the question for every commit rather than only for tagged ones — which
# is what the README section it backs actually asks. Tags stay for marking
# releases; see the README.
#
# A mismatch is a WARNING, not a failure. Upstream moving ahead is normal; it
# means the rice has not been re-verified there yet, which is a prompt to walk
# the inventory and re-pin, not a broken machine.
PIN_FILE="$LOAF_ROOT/packages/omarchy.pin"
if [[ ! -f $PIN_FILE ]]; then
  warn "version pin" "no packages/omarchy.pin — nothing records which Omarchy this was verified against"
elif [[ -z $omarchy_version ]]; then
  : # already reported as a missing package; nothing to compare against
else
  rice_pin=$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]//g' "$PIN_FILE" | head -1)
  if [[ $rice_pin == "$omarchy_version" ]]; then
    ok "version pin" "verified against $omarchy_version"
  else
    warn "version pin" "verified against $rice_pin, Omarchy is $omarchy_version — re-verify, then re-pin"
  fi
fi

# weather-icon carries a byte-for-byte copy of omarchy-weather-icon's condition
# code to glyph table, because upstream's version is welded to its own fetch and
# cannot be called for the mapping alone (ADR-0031). A copy is drift waiting to
# happen, so ask it whether the original still agrees. Cosmetic when it fails —
# a new condition code renders as the fallback cloud, not as nothing — hence warn
# rather than bad.
if command -v weather-icon >/dev/null 2>&1; then
  if weather-icon --check-icons >/dev/null 2>&1; then
    ok "weather icons" "glyph table matches upstream"
  else
    warn "weather icons" "glyph table drifted from omarchy-weather-icon"
    printf '    %s\n' "run: weather-icon --check-icons"
  fi
fi

# Forks the rice carries and upstream files its hosted widgets structurally
# depend on must notice upstream moving underneath them (ADR-0042 want 1):
# quickshell logs to /dev/null, so drift's first symptom is otherwise visual.
# loaf-forks owns the how, including the fork/watch distinction.
if command -v loaf-forks &>/dev/null && [[ -f $LOAF_ROOT/packages/forks ]]; then
  if loaf-forks --quiet; then
    ok "forks" "upstream unchanged under every recorded fork and watch"
  else
    bad "forks" "upstream moved under a fork or watch" "run 'loaf forks' for what changed"
  fi
fi

# Every upstream file the rice's QML references by absolute path must still
# exist (ADR-0042 want 2): hosted widgets load Panel.qml and friends from
# /usr/share, and an upstream rename breaks them with no error anywhere.
if [[ -d $LOAF_ROOT/.config/omarchy ]]; then
  broken_refs=()
  checked_refs=0
  while IFS= read -r ref; do
    path=${ref#file://}
    checked_refs=$((checked_refs + 1))
    [[ -e $path ]] || broken_refs+=("$path")
  done < <(grep -rhoE '(file://)?/usr/share/omarchy[^"'\''  ]*' \
    "$LOAF_ROOT/.config/omarchy" --include='*.qml' --include='*.js' 2>/dev/null | sort -u)
  if ((${#broken_refs[@]})); then
    bad "upstream refs" "${#broken_refs[@]} referenced upstream path(s) missing" \
      "${broken_refs[@]}" "an omarchy update renamed them — the widgets fail silently"
  elif ((checked_refs)); then
    ok "upstream refs" "$checked_refs referenced upstream path(s) all present"
  fi
fi

# Omarchy backs a file up as <name>.bak.<epoch> right before overwriting it. On a
# stowed machine the thing it overwrote was one of our symlinks, so these are the
# fingerprint of a config we may have silently lost.
mapfile -t backups < <(find "$LOAF_HOME/.config" -name '*.bak.*' -newer "$STATE_DIR/last-heal" 2>/dev/null)
if ((${#backups[@]})); then
  warn "clobbers" "${#backups[@]} config backup(s) since last heal"
  printf '    %s\n' "${backups[@]#$LOAF_HOME/}"
fi

# Launchers the debloat manifest says are removed must stay removed —
# omarchy-refresh-applications restores every default web app on refresh, so a
# resurrected one means an update ran and heal has not. Guarded on the manifest
# existing: a repo without one has made no claim, and "no claim" is not drift.
DEBLOAT_MANIFEST="$LOAF_ROOT/packages/removed.webapps"
if [[ -f $DEBLOAT_MANIFEST ]]; then
  resurrected=()
  while IFS= read -r name; do
    [[ -e $LOAF_HOME/.local/share/applications/$name.desktop ]] && resurrected+=("$name")
  done < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' \
    -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$DEBLOAT_MANIFEST")
  if ((${#resurrected[@]})); then
    bad "debloat" "${#resurrected[@]} removed launcher(s) are back" \
      "${resurrected[@]}" "an update restored them — run 'loaf heal'"
  else
    ok "debloat" "removed defaults stay removed"
  fi
fi

# ---------------------------------------------------------
# Rice — this repo
# ---------------------------------------------------------

layer "Rice ($LOAF_ROOT)"

if [[ ! -d $LOAF_ROOT/.git ]]; then
  bad "repo" "$LOAF_ROOT is not a git checkout"
  exit 1
fi

# Every tracked config file should reach $LOAF_HOME as a symlink pointing back here.
# A real file means something overwrote the link and our version is not live.
linked=0
clobbered=()
missing=()
while IFS= read -r f; do
  target="$LOAF_HOME/$f"
  if [[ -L $target ]]; then
    linked=$((linked + 1))
  elif [[ -e $target ]]; then
    clobbered+=("$f")
  else
    missing+=("$f")
  fi
  # Excludes repo-only paths (never stowed) and Stow's own metadata, which
  # .stow-local-ignore deliberately keeps out of $LOAF_HOME.
done < <(git -C "$LOAF_ROOT" ls-files |
  grep -vE "$REPO_ONLY")

((linked)) && ok "symlinks" "$linked live"
((${#clobbered[@]})) && bad "symlinks" "${#clobbered[@]} replaced by real files" "${clobbered[@]}"
((${#missing[@]})) && bad "symlinks" "${#missing[@]} not installed" "${missing[@]}"

# Repo-only files must not be stowed into $LOAF_HOME. Anything matched here escaped
# .stow-local-ignore.
leaks=()
for f in CONTEXT.md README.md packages.txt docs packages migrations lab; do
  # shellcheck disable=SC2088  # leaks is only ever printed, never used as a path
  [[ -e $LOAF_HOME/$f ]] && leaks+=("~/$f")
done
if ((${#leaks[@]})); then
  bad "leaks" "${#leaks[@]} repo-only path(s) in \$LOAF_HOME" "${leaks[@]}" \
    "add them to .stow-local-ignore, then remove the links"
else
  ok "leaks" "no repo-only paths in \$LOAF_HOME"
fi

if [[ -n $(git -C "$LOAF_ROOT" status --porcelain) ]]; then
  # One array element per line: bad() indents each detail, so passing the whole
  # status as a single argument would leave every line after the first flush left.
  mapfile -t dirty < <(git -C "$LOAF_ROOT" status --short | sed -n '1,6p')
  bad "git" "uncommitted changes" "${dirty[@]}"
else
  ok "git" "clean"
fi

# ---------------------------------------------------------
# Packages and migrations
# ---------------------------------------------------------

layer "Packages"

if loaf-packages --quiet 2>/dev/null; then
  ok "manifest" "all chosen packages installed"
else
  bad "manifest" "manifest and system disagree" "run 'loaf packages' for the diff"
fi

# Flatpaks are a separate Source and appear in neither chosen.packages nor
# packages.txt, so a missing one is invisible to the check above.
# Guarded on the manifest existing as well as on flatpak being installed: a repo
# with no chosen.flatpaks has made no claim about Flatpaks, and "no claim" is not
# a disagreement. Without this the check fails on any tree that predates the
# manifest — including the test fixtures.
if command -v flatpak &>/dev/null && [[ -f $LOAF_ROOT/packages/chosen.flatpaks ]]; then
  if loaf-flatpaks --quiet 2>/dev/null; then
    ok "flatpaks" "all chosen flatpaks installed"
  else
    bad "flatpaks" "flatpak manifest and system disagree" "run 'loaf flatpaks' for the diff"
  fi
fi

layer "Migrations"

pending=0
if [[ -d $LOAF_ROOT/migrations ]]; then
  applied="$STATE_DIR/applied"
  for m in "$LOAF_ROOT"/migrations/*.sh; do
    [[ -e $m ]] || continue
    grep -qxF "$(basename "$m")" "$applied" 2>/dev/null || pending=$((pending + 1))
  done
fi
if ((pending)); then
  bad "pending" "$pending migration(s) not yet applied" "run 'loaf heal'"
else
  ok "pending" "none"
fi

# ---------------------------------------------------------

echo
if ((problems)); then
  printf '\033[31m%d problem(s).\033[0m Run \033[1mloaf heal\033[0m to fix what is fixable.\n' "$problems"
  exit 1
fi
printf '\033[32mNo problems.\033[0m\n'
