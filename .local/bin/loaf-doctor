#!/bin/bash

# loaf:summary=Check the three layers for drift, without changing anything

# This machine is three layers deep: CachyOS is the base, Omarchy is the desktop
# layered on with a third-party bridge repo (ADR-0001), and the rice sits on top
# of both. Each layer updates on its own schedule and can quietly undo the one
# above it, so this asserts what should be true and reports what is not.
#
# Read-only by construction: it never writes, never sudos, and never touches the
# network. `loaf heal` is the half that fixes things. Exits non-zero if anything
# is wrong, so it can gate a hook.

set -uo pipefail

# $LOAF_HOME is $HOME everywhere except the test suite, which points it at a
# fixture tree. Every path below derives from it, so nothing reaches the real
# home directory unless it was asked to.
LOAF_HOME="${LOAF_HOME:-$HOME}"
LOAF_ROOT="${LOAF_ROOT:-$LOAF_HOME/shokupan}"

# Tracked paths that are repo furniture, not config, and so must never be
# symlinked into the home directory. This has to agree with .stow-local-ignore
# — they answer the same question from opposite ends, and when they disagree
# doctor reports a file as missing that stow was never going to install. The
# test suite asserts they stay in step.
REPO_ONLY='^(lab/|docs/|packages/|migrations/|test/|README|CONTEXT|packages\.txt|\.gitignore|\.stow-local-ignore)'
BRIDGE_ROOT="${BRIDGE_ROOT:-$LOAF_HOME/omarchy-on-cachyos}"
OMARCHY_ROOT="${OMARCHY_PATH:-$LOAF_HOME/.local/share/omarchy}"
STATE_DIR="${XDG_STATE_HOME:-$LOAF_HOME/.local/state}/loaf"

problems=0

layer() { printf '\n\033[1m%s\033[0m\n' "$1"; }

ok() { printf '  \033[32m✓\033[0m %-14s %s\n' "$1" "${2:-}"; }

bad() {
  problems=$((problems + 1))
  printf '  \033[31m✗\033[0m %-14s %s\n' "$1" "$2"
  local detail
  for detail in "${@:3}"; do printf '    %s\n' "$detail"; done
}

warn() { printf '  \033[33m!\033[0m %-14s %s\n' "$1" "$2"; }

# ---------------------------------------------------------
# Base — CachyOS, and the bridge that put Omarchy on it
# ---------------------------------------------------------

layer "Base (CachyOS)"

if [[ -d $BRIDGE_ROOT ]]; then
  # ADR-0001: the installer shipped with two scripts disagreeing about where the
  # Omarchy checkout goes. The fix is an uncommitted local edit, so a `git pull`
  # in the bridge repo silently reverts it and the next install breaks again.
  if grep -q 'SCRIPT_DIR/\.\./\.\./omarchy' "$BRIDGE_ROOT/bin/fetch-omarchy.sh" \
    "$BRIDGE_ROOT/bin/install-omarchy-on-cachyos.sh" 2>/dev/null; then
    bad "bridge patch" "ADR-0001 installer path fix has been reverted" \
      "upstream reset the ../../omarchy path — reapply before re-running the installer"
  else
    ok "bridge patch" "ADR-0001 path fix intact (uncommitted, as expected)"
  fi
else
  warn "bridge" "$BRIDGE_ROOT missing — cannot re-run the Omarchy installer"
fi

if [[ -d $LOAF_HOME/omarchy ]]; then
  # shellcheck disable=SC2088  # display text for a human, not a path to expand
  bad "stale clone" "~/omarchy exists again" \
      "ADR-0001: this is the wrong-path clone, it should not come back"
else
  ok "stale clone" "no ~/omarchy"
fi

# Omarchy is a DESKTOP layer here and nothing more. The base is CachyOS, and the
# base is not Omarchy's to manage -- see ADR-0034.
#
# The specific hazard: `omarchy-channel-set` calls `omarchy-refresh-pacman`, which
# does `cp -f $OMARCHY_PATH/default/pacman/pacman-<channel>.conf /etc/pacman.conf`
# and then `pacman -Syyuu --noconfirm`. That replaces the repo list with Omarchy's
# vanilla-Arch one and the second `u` permits DOWNGRADES, so every znver4-optimised
# package rolls back to stock Arch and linux-cachyos loses its repo. It nearly ran
# on this machine on 2026-08-08 and was stopped only by an unrelated failure
# short-circuiting the `&&`.
#
# A PATH shim cannot guard this: Omarchy's bin sits ahead of ~/.local/bin in PATH
# (index 2 vs 14), so a same-named script here would never be reached. Hence a
# check, which at least makes the damage loud and immediate.

if [[ -f /etc/pacman.conf ]]; then
  cachyos_repos=$(grep -c '^\[cachyos' /etc/pacman.conf 2>/dev/null || echo 0)
  if ((cachyos_repos >= 1)); then
    ok "repos" "$cachyos_repos CachyOS repo section(s)"
  else
    bad "repos" "no CachyOS repos in /etc/pacman.conf" \
      "the base has been replaced with stock Arch — restore /etc/pacman.conf.bak" \
      "then re-run the bridge installer; do NOT run omarchy-channel-set"
  fi

  # A bridge adaptation with a side effect on /etc rather than in the checkout, so
  # the "cachyos patch" check below cannot see it. CachyOS ships its own walker,
  # which would otherwise overwrite Omarchy's.
  if grep -q '^IgnorePkg *=.*walker' /etc/pacman.conf 2>/dev/null; then
    ok "walker hold" "IgnorePkg keeps CachyOS's walker out"
  else
    warn "walker hold" "IgnorePkg = walker is gone from /etc/pacman.conf — CachyOS's walker can replace Omarchy's"
  fi
fi

# The other bridge side effect on /etc. Losing it does not break the desktop, but
# it silently changes which wifi backend is in use.
nm_conf=/etc/NetworkManager/NetworkManager.conf
if [[ -f $nm_conf ]]; then
  if grep -q '^wifi.backend=iwd' "$nm_conf" 2>/dev/null; then
    ok "wifi backend" "iwd"
  else
    warn "wifi backend" "wifi.backend=iwd is gone from NetworkManager.conf"
  fi
fi

if [[ $(uname -r) == *cachyos* ]]; then
  ok "kernel" "$(uname -r)"
else
  warn "kernel" "running $(uname -r) — not a CachyOS kernel"
fi

# ---------------------------------------------------------
# Desktop — Omarchy
# ---------------------------------------------------------

layer "Desktop (Omarchy)"

if [[ -d $OMARCHY_ROOT/.git ]]; then
  ok "checkout" "$(git -C "$OMARCHY_ROOT" describe --tags --always 2>/dev/null || echo present)"

  # Which Omarchy this rice was last VERIFIED against, versus what is installed.
  # The rice reaches into upstream's files -- bar modules, menu overrides, window
  # rules -- so "does this work" is only answerable together with a version. Each
  # verified state is tagged omarchy-vX.Y.Z; see the README.
  #
  # The tag on the checkout is the source of truth, NOT `omarchy-version`: that
  # just cats $OMARCHY_PATH/version, a file written at install time which lags.
  # Measured 2026-08-08: it said 3.8.3 on a tree whose tag was v3.8.4.
  #
  # A mismatch is a WARNING, not a failure. Upstream moving ahead is normal; it
  # means the rice has not been re-verified there yet, which is a prompt to walk
  # the inventory and re-tag, not a broken machine.
  installed_omarchy=$(git -C "$OMARCHY_ROOT" describe --tags --always 2>/dev/null)
  rice_pin=$(git -C "$LOAF_ROOT" tag -l 'omarchy-v*' 2>/dev/null | sort -V | tail -1)
  if [[ -z $rice_pin ]]; then
    warn "version pin" "no omarchy-v* tag — nothing records which Omarchy this was verified against"
  elif [[ ${rice_pin#omarchy-} == "$installed_omarchy" ]]; then
    ok "version pin" "verified against $installed_omarchy"
  else
    warn "version pin" "verified against ${rice_pin#omarchy-}, Omarchy is $installed_omarchy — re-verify, then re-tag"
  fi

  # Omarchy's tree is NOT pristine here and should not be. The bridge installer
  # seds CachyOS adaptations directly into it (ADR-0001), so these files are
  # expected to show as modified. They are uncommitted, which means an
  # `omarchy update` git pull can revert them — so check the adaptations
  # themselves rather than just counting dirty files.
  expected='^(install\.sh|install/(config/(hardware/(network|nvidia)|omarchy-ai-skill|walker-elephant)\.sh|login/all\.sh|omarchy-base\.packages|post-install/all\.sh|preflight/all\.sh)|bin/omarchy-update-restart)$'

  # Read into an array so each path becomes its own detail line. Relying on word
  # splitting instead would break on a filename containing a space, and could
  # glob if one contained a *.
  mapfile -t unexpected < <(git -C "$OMARCHY_ROOT" status --porcelain 2>/dev/null |
    awk '{print $2}' | grep -vE "$expected")
  if ((${#unexpected[@]})); then
    bad "checkout" "edits upstream does not expect" "${unexpected[@]}" \
      "the bridge's CachyOS patches are fine; these are not — they vanish on update"
  fi

  # Sentinels for the CachyOS adaptations that are still load-bearing.
  #
  # Deliberately NOT checked: the bridge also seds bin/omarchy-update-restart to
  # swap `pacman -Q linux` for linux-cachyos. Upstream has since rewritten that
  # script to compare /usr/lib/modules/*/vmlinuz against `uname -r`, which is
  # distro-agnostic and already correct here — the patch is obsolete, and
  # asserting it would fail forever on a machine that is fine. Re-add a check
  # only if kernel-restart prompts actually misbehave.
  reverted=()
  grep -qx 'tldr' "$OMARCHY_ROOT/install/omarchy-base.packages" 2>/dev/null &&
    reverted+=("tldr back in omarchy-base.packages — conflicts with tealdeer")
  grep -q 'preflight/pacman\.sh' "$OMARCHY_ROOT/install/preflight/all.sh" 2>/dev/null &&
    reverted+=("preflight/pacman.sh restored — conflicts with CachyOS packages")

  if ((${#reverted[@]})); then
    bad "cachyos patch" "${#reverted[@]} bridge adaptation(s) reverted" "${reverted[@]}" \
      "re-run ~/omarchy-on-cachyos/bin/install-omarchy-on-cachyos.sh"
  else
    ok "cachyos patch" "bridge adaptations intact"
  fi
else
  bad "checkout" "$OMARCHY_ROOT is not a git checkout"
fi

# weather-icon carries a byte-for-byte copy of omarchy-weather-icon's condition
# code to glyph table, because upstream's version is welded to its own fetch and
# cannot be called for the mapping alone (ADR-0031). A copy is drift waiting to
# happen, so ask it whether the original still agrees. Cosmetic when it fails —
# a new condition code renders as the fallback cloud, not as nothing — hence warn
# rather than bad.
if command -v weather-icon >/dev/null 2>&1; then
  if weather-icon --check-icons >/dev/null 2>&1; then
    ok "weather icons" "glyph table matches upstream"
  else
    warn "weather icons" "glyph table drifted from omarchy-weather-icon"
    printf '    %s\n' "run: weather-icon --check-icons"
  fi
fi

# Omarchy backs a file up as <name>.bak.<epoch> right before overwriting it. On a
# stowed machine the thing it overwrote was one of our symlinks, so these are the
# fingerprint of a config we may have silently lost.
mapfile -t backups < <(find "$LOAF_HOME/.config" -name '*.bak.*' -newer "$STATE_DIR/last-heal" 2>/dev/null)
if ((${#backups[@]})); then
  warn "clobbers" "${#backups[@]} config backup(s) since last heal"
  printf '    %s\n' "${backups[@]#$LOAF_HOME/}"
fi

# ---------------------------------------------------------
# Rice — this repo
# ---------------------------------------------------------

layer "Rice ($LOAF_ROOT)"

if [[ ! -d $LOAF_ROOT/.git ]]; then
  bad "repo" "$LOAF_ROOT is not a git checkout"
  exit 1
fi

# Every tracked config file should reach $LOAF_HOME as a symlink pointing back here.
# A real file means something overwrote the link and our version is not live.
linked=0
clobbered=()
missing=()
while IFS= read -r f; do
  target="$LOAF_HOME/$f"
  if [[ -L $target ]]; then
    linked=$((linked + 1))
  elif [[ -e $target ]]; then
    clobbered+=("$f")
  else
    missing+=("$f")
  fi
  # Excludes repo-only paths (never stowed) and Stow's own metadata, which
  # .stow-local-ignore deliberately keeps out of $LOAF_HOME.
done < <(git -C "$LOAF_ROOT" ls-files |
  grep -vE "$REPO_ONLY")

((linked)) && ok "symlinks" "$linked live"
((${#clobbered[@]})) && bad "symlinks" "${#clobbered[@]} replaced by real files" "${clobbered[@]}"
((${#missing[@]})) && bad "symlinks" "${#missing[@]} not installed" "${missing[@]}"

# Repo-only files must not be stowed into $LOAF_HOME. Anything matched here escaped
# .stow-local-ignore.
leaks=()
for f in CONTEXT.md README.md packages.txt docs packages migrations lab; do
  # shellcheck disable=SC2088  # leaks is only ever printed, never used as a path
  [[ -e $LOAF_HOME/$f ]] && leaks+=("~/$f")
done
if ((${#leaks[@]})); then
  bad "leaks" "${#leaks[@]} repo-only path(s) in \$LOAF_HOME" "${leaks[@]}" \
    "add them to .stow-local-ignore, then remove the links"
else
  ok "leaks" "no repo-only paths in \$LOAF_HOME"
fi

if [[ -n $(git -C "$LOAF_ROOT" status --porcelain) ]]; then
  # One array element per line: bad() indents each detail, so passing the whole
  # status as a single argument would leave every line after the first flush left.
  mapfile -t dirty < <(git -C "$LOAF_ROOT" status --short | sed -n '1,6p')
  bad "git" "uncommitted changes" "${dirty[@]}"
else
  ok "git" "clean"
fi

# ---------------------------------------------------------
# Packages and migrations
# ---------------------------------------------------------

layer "Packages"

if loaf-packages --quiet 2>/dev/null; then
  ok "manifest" "all chosen packages installed"
else
  bad "manifest" "manifest and system disagree" "run 'loaf packages' for the diff"
fi

# Flatpaks are a separate Source and appear in neither chosen.packages nor
# packages.txt, so a missing one is invisible to the check above.
# Guarded on the manifest existing as well as on flatpak being installed: a repo
# with no chosen.flatpaks has made no claim about Flatpaks, and "no claim" is not
# a disagreement. Without this the check fails on any tree that predates the
# manifest — including the test fixtures.
if command -v flatpak &>/dev/null && [[ -f $LOAF_ROOT/packages/chosen.flatpaks ]]; then
  if loaf-flatpaks --quiet 2>/dev/null; then
    ok "flatpaks" "all chosen flatpaks installed"
  else
    bad "flatpaks" "flatpak manifest and system disagree" "run 'loaf flatpaks' for the diff"
  fi
fi

layer "Migrations"

pending=0
if [[ -d $LOAF_ROOT/migrations ]]; then
  applied="$STATE_DIR/applied"
  for m in "$LOAF_ROOT"/migrations/*.sh; do
    [[ -e $m ]] || continue
    grep -qxF "$(basename "$m")" "$applied" 2>/dev/null || pending=$((pending + 1))
  done
fi
if ((pending)); then
  bad "pending" "$pending migration(s) not yet applied" "run 'loaf heal'"
else
  ok "pending" "none"
fi

# ---------------------------------------------------------

echo
if ((problems)); then
  printf '\033[31m%d problem(s).\033[0m Run \033[1mloaf heal\033[0m to fix what is fixable.\n' "$problems"
  exit 1
fi
printf '\033[32mNo problems.\033[0m\n'
