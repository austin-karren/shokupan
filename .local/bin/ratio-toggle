#!/usr/bin/env bash
#
# The single-window zen aspect ratio: hold a lone tiled window to a readable column
# instead of letting it span the display. Omarchy's own feature, renamed from "square"
# to "zen" because the value is no longer 1:1. See ADR-0013 and ADR-0026.
#
#   ratio-toggle --status    print Waybar-style JSON for the current state
#   ratio-toggle             flip it (delegates to omarchy-hyprland-toggle)
#
# ONE FLAG FILE, AND ITS CONTENTS NO LONGER MATTER
#
# Under quattro the flag is ~/.local/state/omarchy/toggles/hypr/
# single-window-aspect-ratio.lua, and ~/.config/hypr/hyprland.lua applies the zen
# value itself whenever that file EXISTS:
#
#     hl.config({ layout = { single_window_aspect_ratio = { 6, 5 } } })
#
# That kills the whole repair mechanism this script used to carry. In the .conf
# era, Omarchy's toggle copied a file hardcoding `1 1`, so --status had to detect
# the wrong contents and rewrite them on every bar poll. Now the value is fixed at
# config time, in the same reload the toggle itself issues — the Toggle Menu,
# SUPER+CTRL+BACKSPACE and this script all converge on 6:5 with nothing polling.
#
# So the toggle path is a straight delegation to
# `omarchy-hyprland-toggle single-window-aspect-ratio`, which copies or removes
# the flag and reloads Hyprland. This script remains only as the bar's adapter:
# --status is the JSON contract .config/omarchy/bar/indicators/Ratio.qml reads every
# 3 seconds, and the click path adds the notification the raw toggle lacks.
#
# WHY THE RATIO IS 6:5 AND NOT WIDER
#
# Hyprland SILENTLY IGNORES this setting unless the constraint would shrink the
# window to 80% or less of the available width. Measured, available area 2284x1484:
#
#   1:1   1484px   65% of full width   applied
#   6:5   1782px   78%                 applied  <- chosen (set in hyprland.lua)
#   1.24  ignored  80.5%
#   3:2   ignored  - and this display IS 3:2, so it would be a no-op anyway
#
# The boundary is 0.8 x the available area's own aspect. The value itself now
# lives in ~/.config/hypr/hyprland.lua; change it there, not here.
#
# THE GLYPH IS AN ESCAPE, NOT A LITERAL
#
# U+F2D0 is written as $'\uF2D0' via bash ANSI-C quoting, not pasted in. An earlier
# revision embedded the character directly, it was lost in an edit, and the bar
# rendered an empty module - the icon vanished with no error anywhere, because a
# module whose text is an empty string looks exactly like one that is deliberately
# blank. An escape survives editing; a private-use codepoint that renders as
# nothing does not.

set -euo pipefail

ASPECT_LABEL="6:5"

# U+F2D0 window-maximize, the glyph Omarchy uses in this feature's own notifications.
GLYPH=$'\uF2D0'

# The quattro flag: existence is the whole signal (see header).
FLAG="$HOME/.local/state/omarchy/toggles/hypr/single-window-aspect-ratio.lua"

if [[ ${1-} == --status ]]; then
  if [[ -f $FLAG ]]; then
    # GLYPH passed as an argument, not spliced into the format string: a stray
    # % in the icon would otherwise be read as a format spec and corrupt the JSON.
    printf '{"text":"%s","tooltip":"Single-window zen aspect ratio\\n\\nOn — a lone window is held to %s.\\nClick to disable.","class":"active"}\n' "$GLYPH" "$ASPECT_LABEL"
  else
    printf '{"text":"%s","tooltip":"Single-window zen aspect ratio\\n\\nOff — a lone window fills the screen.\\nClick to enable."}\n' "$GLYPH"
  fi
  exit 0
fi

[[ -z ${1-} ]] || {
  echo "usage: ratio-toggle [--status]" >&2
  exit 1
}

# Copies or removes the flag and reloads Hyprland; prints "on" or "off".
state=$(omarchy-hyprland-toggle single-window-aspect-ratio)

case $state in
  on) action=Enable ;;
  *) action=Disable ;;
esac

# Omarchy's phrasing, with "square" swapped for "zen" - so the bar, the Toggle Menu
# and the keybinding all announce the same feature by the same name.
command -v notify-send >/dev/null &&
  notify-send -u low "$GLYPH      $action single-window zen aspect ratio"
