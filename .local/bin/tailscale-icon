#!/bin/bash

# Waybar module for the tailnet. Reports whether this machine is on Tailscale, and
# toggles it.
#
# ONE GLYPH FOR EVERY STATE, like custom/ratio: the state is carried by the CSS class
# (opacity), never by a second glyph. That keeps the box width fixed, which matters
# because the right cluster sizes every box to its glyph's measured ink -- a module
# that changed glyph would need a measured width per state, and would move its own
# left gap each time it changed. See the width table in waybar/style.css.
#
# Answers "am I on the tailnet", which is why it sits next to network ("am I on the
# internet") rather than anywhere else in the cluster. See ADR-0029.
#
# `tailscale up`/`down` need no sudo here: OperatorUser is set to this user, so the
# daemon accepts state changes from it. Without that the toggle would silently fail.

set -uo pipefail

GLYPH=$'\U000F0582' # U+F0582 nf-md-vpn
SIGNAL=13

status_json=$(tailscale status --json 2>/dev/null) || status_json=''

if [[ -n $status_json ]]; then
  state=$(jq -r '.BackendState // "Unknown"' <<<"$status_json" 2>/dev/null)
  self=$(jq -r '(.Self.DNSName // "") | sub("\\.$"; "")' <<<"$status_json" 2>/dev/null)
  exit_node=$(jq -r '[.Peer[]? | select(.ExitNode)] | length' <<<"$status_json" 2>/dev/null)
else
  state=Unreachable
  self=''
  exit_node=0
fi

emit() { # class tooltip
  printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$GLYPH" "$1" "$2"
}

if [[ ${1-} == --toggle ]]; then
  if [[ $state == Running ]]; then
    tailscale down >/dev/null 2>&1
  else
    tailscale up >/dev/null 2>&1
  fi
  # Push the new state to the bar now rather than waiting out the poll interval.
  pkill "-RTMIN+$SIGNAL" waybar 2>/dev/null
  exit 0
fi

if [[ ${1-} == --status || -z ${1-} ]]; then
  case $state in
  Running)
    if ((exit_node > 0)); then
      emit exit-node "Tailscale\\n\\nConnected as $self, routing through an exit node.\\nClick to disconnect."
    else
      emit connected "Tailscale\\n\\nConnected as $self.\\nClick to disconnect."
    fi
    ;;
  Stopped)
    emit disconnected "Tailscale\\n\\nDisconnected.\\nClick to connect."
    ;;
  NeedsLogin)
    emit needs-login "Tailscale\\n\\nNot logged in.\\nRun tailscale up in a terminal to authenticate."
    ;;
  Unreachable)
    emit disconnected "Tailscale\\n\\ntailscaled is not responding.\\nCheck: systemctl status tailscaled"
    ;;
  *)
    emit disconnected "Tailscale\\n\\nState: $state"
    ;;
  esac
  exit 0
fi

echo "usage: tailscale-icon [--status|--toggle]" >&2
exit 64
