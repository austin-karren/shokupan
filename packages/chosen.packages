# Packages chosen deliberately, on top of the CachyOS + Omarchy baseline.
#
# This is the manifest: a decision, hand-maintained. packages.txt is the record:
# the raw `pacman -Qqe` dump, regenerated, ~300 entries, mostly not choices.
# `loaf packages` diffs this file against what is installed.
#
# Format matches Omarchy's install/*.packages — one name per line, # comments.

# Omarchy's own bash config expects these three.
# bat is not optional on an Omarchy box: default/bash/envs exports
# MANPAGER="sh -c 'col -bx | bat -l man -p'" unconditionally, so without it
# `man` pipes into a missing binary in any interactive terminal.
bat
eza
tldr

# git: pager and large files
git-delta
git-lfs

# this repo
stow

# multiplexer for everything that is not an agent session — herdr owns those,
# and stays out of this manifest because it self-updates outside pacman
# (ADR-0015). Reinstated 2026-08-09 after a same-day removal.
tmux

# Shelly ships Flatpak support as a separate backend, and its own Enable Flatpak
# toggle can only install it from the AUR — which fails here. Installed from the
# cachyos repo instead; without it the Flatpak tab does not exist.
shelly-flatpak-backend

# shell banner
figlet
lolcat

# editor
zed

# JS runtimes and package managers not handled by mise
bun
pnpm

# cloud and infra
aws-cli-v2
terraform

# per-directory environment loading, hooked in .bashrc
direnv

# Language runtimes are deliberately absent: mise owns those, pinned per-project
# in ~/.config/mise/config.toml, not pacman.

# The KDE Breeze cursor, this machine's pointer since before quattro. Tracked
# because the theme has to exist before .icons/default/index.theme and
# uwsm/env.d/30-cursor-theme can point at it (2026-08-18).
breeze-cursors
